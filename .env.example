# ── Site ─────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for sitemap + canonical/OG tags)
SITE_URL=https://cityproperty.example.com

# ── Business contact (drives lead delivery) ──────────────────────────
# WhatsApp number in international format, DIGITS ONLY (no +, spaces, dashes)
PUBLIC_WHATSAPP=919876543210
# Phone for click-to-call buttons (human-readable is fine)
PUBLIC_PHONE=+91 98765 43210
# Inbox that should receive form leads (configured in Netlify Forms UI too)
PUBLIC_LEAD_EMAIL=leads@cityproperty.example.com

# ── Sanity (listings CMS) ────────────────────────────────────────────
# From sanity.io/manage. When BOTH are set, the site reads live content;
# when unset, it falls back to bundled sample data in src/data/sample.ts.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# ── Map ──────────────────────────────────────────────────────────────
# Mapbox public access token (pk.…). When unset, the styled CSS map shows.
PUBLIC_MAPBOX_TOKEN=
# Optional: a custom Mapbox style URL matching the navy brand palette
PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
