---
import '../styles/system.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { site, contact, social } from '../lib/config';

interface Crumb { name: string; url: string }

interface Props {
  title: string;
  description?: string;
  /** Active top-nav key: buy | rent | sell | map | guide | blog | consult */
  active?: string;
  /** Nav variant: 'site' (public) or 'guide' (style guide) */
  navVariant?: 'site' | 'guide';
  /** OG/social preview image (absolute or root-relative) */
  ogImage?: string;
  /** Hide the floating WhatsApp button (e.g. style guide) */
  hideFloatingWhatsApp?: boolean;
  /** Keep this page out of search results (admin, thanks, internal tools). */
  noindex?: boolean;
  /** og:type — 'website' (default) or 'article' for blog posts. */
  ogType?: string;
  /** Breadcrumb trail for nested pages → BreadcrumbList schema. */
  breadcrumbs?: Crumb[];
  /** Extra page-level JSON-LD (Article, Service, Product, etc.). */
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Article timestamps (ISO) for blog posts. */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = 'Ahmedabad’s full spectrum property team for residential, commercial, land, industrial and warehousing. Find your place in the city.',
  active,
  navVariant = 'site',
  ogImage = '/logo/city-property-logo.png',
  hideFloatingWhatsApp = false,
  noindex = false,
  ogType = 'website',
  breadcrumbs,
  jsonLd,
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageAbs = new URL(ogImage, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// ── Structured data (Schema.org JSON-LD) ───────────────────────────────
// Sitewide: the agency itself + the website. Real info only, no ratings.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/logo/city-property-logo-navy.png`,
  image: `${site.url}/logo/city-property-logo-navy.png`,
  telephone: contact.phone,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '703 & 704 Zion Prime, Near Copper Stone, Thaltej Shilaj Road',
    addressLocality: 'Ahmedabad',
    addressRegion: 'Gujarat',
    postalCode: '380052',
    addressCountry: 'IN',
  },
  areaServed: [
    { '@type': 'City', name: 'Ahmedabad' },
    { '@type': 'City', name: 'Gandhinagar' },
    { '@type': 'Place', name: 'GIFT City' },
    { '@type': 'AdministrativeArea', name: 'Gujarat' },
  ],
  knowsAbout: [
    'Residential property', 'Commercial property', 'Office leasing', 'Retail space',
    'Warehouse and industrial', 'Land and plots', 'Property investment',
  ],
  sameAs: [social.instagram, social.linkedin],
};
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  publisher: { '@id': `${site.url}/#organization` },
};
const schemas: Record<string, unknown>[] = [orgSchema, webSiteSchema];
if (breadcrumbs?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.url, site.url).href,
    })),
  });
}
if (jsonLd) (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).forEach((s) => schemas.push(s));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/logo/city-property-mark.png" />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large" />}

  <!-- Open Graph / social -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbs} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />

  <!-- Structured data -->
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

  <!-- Google Analytics 4 — runs only on the live domain so localhost/previews
       don't pollute the data. Tracks page views plus lead-intent events. -->
  <script is:inline>
    (function () {
      var host = location.hostname;
      if (host !== 'cityprop.co.in' && host !== 'www.cityprop.co.in') return;
      var ID = 'G-5MZTJ0FL9T';
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', ID);
      // Lead-intent events: phone tap, WhatsApp tap, and form submissions.
      document.addEventListener('click', function (e) {
        var a = e.target.closest ? e.target.closest('a') : null;
        if (!a) return;
        var h = a.getAttribute('href') || '';
        if (h.indexOf('wa.me') > -1) gtag('event', 'whatsapp_click');
        else if (h.indexOf('tel:') === 0) gtag('event', 'phone_click');
      }, true);
      document.addEventListener('lead:success', function (e) {
        var f = (e.target && e.target.getAttribute && e.target.getAttribute('name')) || 'lead';
        gtag('event', 'generate_lead', { form_name: f });
      });
    })();
  </script>

  <!-- Page-transition failsafe: mark html early, always reveal (verbatim from bundle) -->
  <script is:inline>
    (function () {
      document.documentElement.classList.add('pt-js');
      function show() {
        if (document.body) {
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              document.body.classList.add('pt-ready');
            });
          });
        }
      }
      if (document.readyState !== 'loading') show();
      else document.addEventListener('DOMContentLoaded', show);
      setTimeout(function () {
        document.body && document.body.classList.add('pt-ready');
      }, 1500);
    })();
  </script>
</head>
<body>
  <Nav variant={navVariant} active={active} />

  <slot />

  <Footer />
  {!hideFloatingWhatsApp && <FloatingWhatsApp />}

  <!-- Shared interactions, scroll motion, page transitions (ported from bundle) -->
  <script>
    import '../scripts/site.js';
    import '../scripts/motion.js';
    import '../scripts/transitions.js';
    import '../scripts/favorites.ts';
  </script>
</body>
</html>
