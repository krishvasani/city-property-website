---
import '../styles/system.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { site, contact, social } from '../lib/config';
import { imageSize } from '../lib/image-size';

interface Crumb { name: string; url: string }

interface Props {
  title: string;
  description?: string;
  /** Active top-nav key: buy | rent | sell | map | guide | blog | consult */
  active?: string;
  /** Nav variant: 'site' (public) or 'guide' (style guide) */
  navVariant?: 'site' | 'guide';
  /** OG/social preview image (absolute or root-relative) */
  ogImage?: string;
  /** Alt text for the OG image (og:image:alt). */
  ogImageAlt?: string;
  /** Hide the floating WhatsApp button (e.g. style guide) */
  hideFloatingWhatsApp?: boolean;
  /** Keep this page out of search results (admin, thanks, internal tools). */
  noindex?: boolean;
  /** og:type — 'website' (default) or 'article' for blog posts. */
  ogType?: string;
  /** Breadcrumb trail for nested pages → BreadcrumbList node in the graph. */
  breadcrumbs?: Crumb[];
  /**
   * Extra page-level JSON-LD node(s) merged into the single @graph. Nodes
   * without an @id get `{canonical}#{type}`. A page may also pass its own
   * BreadcrumbList node, in which case `breadcrumbs` should be omitted.
   */
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Article timestamps (ISO) for blog posts. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Append " | City Property Services" to the <title>. Property pages turn this off. */
  brandSuffix?: boolean;
}

const {
  title,
  description = 'Ahmedabad’s full spectrum property team for residential, commercial, land, industrial and warehousing. Find your place in the city.',
  active,
  navVariant = 'site',
  ogImage = '/logo/city-property-logo.png',
  ogImageAlt = `${site.name} — property consultants in Ahmedabad`,
  hideFloatingWhatsApp = false,
  noindex = false,
  ogType = 'website',
  breadcrumbs,
  jsonLd,
  publishedTime,
  modifiedTime,
  brandSuffix = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageAbs = new URL(ogImage, site.url).href;
const ogSize = imageSize(ogImage);
const fullTitle = brandSuffix && !title.includes(site.name) ? `${title} | ${site.name}` : title;

// ── Structured data: ONE JSON-LD block, one @graph, every node has an @id ──
// Sitewide nodes: the agency (RealEstateAgent), its founder, CIRIL, the
// website. Real info only — no ratings (there are no on-page reviews).
const ORG_ID = `${site.url}/#organization`;
const WEBSITE_ID = `${site.url}/#website`;
const FOUNDER_ID = `${site.url}/#founder`;
const CIRIL_ID = 'https://www.ciril.in/#organization';
const LOGO = `${site.url}/logo/city-property-logo-navy.png`;
const logoSize = imageSize('/logo/city-property-logo-navy.png');

const orgNode = {
  '@type': 'RealEstateAgent',
  '@id': ORG_ID,
  name: site.name,
  alternateName: 'CPS Ahmedabad',
  url: `${site.url}/`,
  logo: { '@type': 'ImageObject', '@id': `${site.url}/#logo`, url: LOGO, contentUrl: LOGO, ...(logoSize ?? {}) },
  image: LOGO,
  telephone: contact.phoneE164,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '703 & 704 Zion Prime, Near Copper Stone, Thaltej Shilaj Road',
    addressLocality: 'Ahmedabad',
    addressRegion: 'Gujarat',
    postalCode: '380052',
    addressCountry: 'IN',
  },
  geo: { '@type': 'GeoCoordinates', latitude: contact.office.lat, longitude: contact.office.lng },
  hasMap: contact.office.mapUrl,
  openingHours: contact.office.openingHours,
  priceRange: '₹₹₹',
  foundingDate: '1999',
  founder: { '@id': FOUNDER_ID },
  employee: { '@id': FOUNDER_ID },
  memberOf: { '@id': CIRIL_ID },
  areaServed: [
    { '@type': 'City', '@id': `${site.url}/#area-ahmedabad`, name: 'Ahmedabad', sameAs: 'https://www.wikidata.org/entity/Q1070' },
    { '@type': 'City', '@id': `${site.url}/#area-gandhinagar`, name: 'Gandhinagar', sameAs: 'https://www.wikidata.org/entity/Q11910' },
  ],
  knowsAbout: [
    'Residential property', 'Corporate office space', 'Retail and showroom space',
    'Industrial property', 'Warehousing and logistics', 'Land and plots', 'Property investment',
  ],
  identifier: { '@type': 'PropertyValue', propertyID: 'RERA', value: site.rera },
  sameAs: [social.instagram, social.linkedin],
};
const founderNode = {
  '@type': 'Person',
  '@id': FOUNDER_ID,
  name: 'Mukesh Vasani',
  jobTitle: 'Founder',
  worksFor: { '@id': ORG_ID },
  affiliation: { '@id': CIRIL_ID },
  knowsAbout: ['Ahmedabad real estate', 'Commercial property', 'Property investment'],
};
const cirilNode = {
  '@type': 'Organization',
  '@id': CIRIL_ID,
  name: 'CIRIL',
  url: 'https://www.ciril.in/',
  description: 'Owner-operated commercial real estate network across 30+ Indian cities.',
};
const webSiteNode = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: site.name,
  url: `${site.url}/`,
  publisher: { '@id': ORG_ID },
  inLanguage: 'en-IN',
};

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const graph: Record<string, any>[] = [orgNode, founderNode, cirilNode, webSiteNode];
if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.url, site.url).href,
    })),
  });
}
if (jsonLd) {
  for (const node of Array.isArray(jsonLd) ? jsonLd : [jsonLd]) {
    const { '@context': _ctx, ...rest } = node;
    if (!rest['@id']) rest['@id'] = `${canonical}#${String(rest['@type'] ?? 'node').toLowerCase()}`;
    graph.push(rest);
  }
}
const jsonLdText = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/logo/city-property-mark.png" />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large" />}

  <!-- Open Graph / social -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbs} />
  {ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
  {ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
  <meta property="og:image:alt" content={ogImageAlt} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Structured data: a single @graph (see frontmatter) -->
  <script type="application/ld+json" set:html={jsonLdText} />

  <!-- Google Analytics 4 — runs only on the live domain so localhost/previews
       don't pollute the data. Tracks page views plus lead-intent events. -->
  <script is:inline>
    (function () {
      var host = location.hostname;
      if (host !== 'cityprop.co.in' && host !== 'www.cityprop.co.in') return;
      var ID = 'G-5MZTJ0FL9T';
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', ID);
      // Lead-intent events: phone tap, WhatsApp tap, and form submissions.
      document.addEventListener('click', function (e) {
        var a = e.target.closest ? e.target.closest('a') : null;
        if (!a) return;
        var h = a.getAttribute('href') || '';
        if (h.indexOf('wa.me') > -1) gtag('event', 'whatsapp_click');
        else if (h.indexOf('tel:') === 0) gtag('event', 'phone_click');
      }, true);
      document.addEventListener('lead:success', function (e) {
        var f = (e.target && e.target.getAttribute && e.target.getAttribute('name')) || 'lead';
        gtag('event', 'generate_lead', { form_name: f });
      });
    })();
  </script>

  <!-- Page transitions: opt in only when JS runs. The entry fade is a CSS
       animation that always ends visible (see system.css), so no reveal
       failsafe is needed — without JS, nothing is ever hidden. -->
  <script is:inline>document.documentElement.classList.add('pt-js');</script>
</head>
<body>
  <Nav variant={navVariant} active={active} />

  <slot />

  <Footer />
  {!hideFloatingWhatsApp && <FloatingWhatsApp />}

  <!-- Shared interactions, scroll motion, page transitions (ported from bundle) -->
  <script>
    import '../scripts/site.js';
    import '../scripts/motion.js';
    import '../scripts/transitions.js';
    import '../scripts/favorites.ts';
  </script>
</body>
</html>
