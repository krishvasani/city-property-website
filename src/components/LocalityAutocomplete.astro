---
// Restricted locality search box: shows matching areas as you type and only
// lets you pick from the localities we cover (src/data/localities.ts). Unlike
// LocalitySelect (forms, where free text is allowed), this is strict — the
// selected value is always a real locality id.
//
// - Renders a hidden input (when `hiddenName` is set) carrying the chosen id,
//   so it submits inside a GET form (e.g. the hero search -> /buy?locality=id).
// - Dispatches `locality:change` ({ id, name }) so client scripts can react
//   (e.g. the Buy/Rent results filter).
// - `paramKey` preselects from the current URL (?<paramKey>=id); `value`
//   is a static fallback preselect.
import { getGroupedLocalities } from '../data/localities';

interface Props {
  id?: string;
  hiddenName?: string;
  value?: string;     // preselected locality id
  paramKey?: string;  // read this URL query param to preselect
  placeholder?: string;
  required?: boolean;
  class?: string;
}
const {
  id = 'loc-ac',
  hiddenName,
  value = '',
  paramKey,
  placeholder = 'Search a locality or area…',
  required = false,
  class: className,
} = Astro.props;

const groups = getGroupedLocalities();
const blob = (s: string[]) => s.filter(Boolean).join(' ').toLowerCase();
---
<div class:list={['loc-ac', className]} data-loc-ac data-value={value} data-param={paramKey}>
  <input
    class="loc-ac-input"
    id={id}
    type="text"
    role="combobox"
    autocomplete="off"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls={`${id}-panel`}
    placeholder={placeholder}
    required={required}
  />
  {hiddenName && <input type="hidden" name={hiddenName} class="loc-ac-hidden" />}

  <div class="loc-panel" id={`${id}-panel`} role="listbox" hidden>
    {groups.map((g) => (
      <div class="loc-group" data-group>
        <div class="loc-group-h">{g.group}</div>
        {g.items.map((it) => (
          <button
            type="button"
            class="loc-opt"
            role="option"
            data-id={it.id}
            data-name={it.name}
            data-search={blob([it.name, ...it.aliases, it.region, it.microMarket, it.group, ...it.type, ...it.popularFor, ...it.searchKeywords])}
          >
            <span class="loc-opt-name">{it.name}</span>
            <span class="loc-opt-sub">{it.region} · {it.type.join(', ')}</span>
          </button>
        ))}
      </div>
    ))}
    <div class="loc-empty" hidden>No areas match. Try Bopal, Sanand, GIFT or warehouse.</div>
  </div>
</div>

<style>
  .loc-ac { position: relative; flex: 1; min-width: 0; }
  .loc-ac-input { width: 100%; }
  .loc-panel {
    position: absolute; top: calc(100% + 10px); left: 0; z-index: 60;
    width: max(100%, 360px); max-width: 92vw; max-height: 340px; overflow-y: auto;
    background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r);
    box-shadow: var(--shadow-lg); padding: 8px; text-align: left;
  }
  .loc-group + .loc-group { border-top: 1px solid var(--hairline); margin-top: 4px; }
  .loc-group-h { font-size: 10.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--text-faint); padding: 12px 10px 5px; }
  .loc-opt { display: flex; flex-direction: column; gap: 2px; width: 100%; min-width: 0; text-align: left; border: none; background: transparent; cursor: pointer; padding: 8px 10px; border-radius: var(--r-xs); }
  .loc-opt:hover, .loc-opt.is-active { background: var(--navy-tint); }
  .loc-opt-name { font-size: 14.5px; font-weight: 600; color: var(--ink); line-height: 1.3; }
  .loc-opt-sub { font-size: 12px; color: var(--text-muted); text-transform: capitalize; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .loc-empty { padding: 14px 10px; font-size: 13px; color: var(--text-muted); }
  /* tidy scrollbar */
  .loc-panel::-webkit-scrollbar { width: 10px; }
  .loc-panel::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; border: 3px solid var(--surface); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-loc-ac]').forEach((ac) => {
    const input = ac.querySelector('.loc-ac-input') as HTMLInputElement;
    const hidden = ac.querySelector('.loc-ac-hidden') as HTMLInputElement | null;
    const panel = ac.querySelector('.loc-panel') as HTMLElement;
    const opts = Array.from(ac.querySelectorAll<HTMLElement>('.loc-opt'));
    const groups = Array.from(ac.querySelectorAll<HTMLElement>('.loc-group'));
    const empty = ac.querySelector('.loc-empty') as HTMLElement;
    let active = -1;

    const open = () => { panel.hidden = false; input.setAttribute('aria-expanded', 'true'); };
    const close = () => { panel.hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; opts.forEach((o) => o.classList.remove('is-active')); };
    const visible = () => opts.filter((o) => o.style.display !== 'none');

    function emit(id: string, name: string) {
      input.dispatchEvent(new CustomEvent('locality:change', { detail: { id, name }, bubbles: true }));
    }
    function select(id: string, name: string, doEmit = true) {
      input.value = name;
      if (hidden) hidden.value = id;
      ac.dataset.selectedId = id;
      if (doEmit) emit(id, name);
    }
    function clearSelection(doEmit = true) {
      if (hidden) hidden.value = '';
      ac.dataset.selectedId = '';
      if (doEmit) emit('', '');
    }

    function filter() {
      const q = input.value.trim().toLowerCase();
      const selName = (opts.find((o) => o.dataset.id === ac.dataset.selectedId)?.dataset.name || '').toLowerCase();
      // typing query: if it equals the current selection name, show everything
      const eff = q === selName ? '' : q;
      let shown = 0;
      opts.forEach((o) => {
        const match = !eff || (o.dataset.search || '').includes(eff);
        o.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      groups.forEach((g) => {
        const any = Array.from(g.querySelectorAll<HTMLElement>('.loc-opt')).some((o) => o.style.display !== 'none');
        g.style.display = any ? '' : 'none';
      });
      empty.hidden = shown !== 0;
      active = -1; opts.forEach((o) => o.classList.remove('is-active'));
    }

    input.addEventListener('focus', () => { filter(); open(); });
    input.addEventListener('input', () => {
      // editing invalidates the previous strict selection until they pick again
      if (input.value.trim().toLowerCase() !== (opts.find((o) => o.dataset.id === ac.dataset.selectedId)?.dataset.name || '').toLowerCase()) {
        clearSelection();
      }
      filter(); open();
    });
    input.addEventListener('keydown', (e) => {
      const vis = visible();
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (panel.hidden) { filter(); open(); }
        active = e.key === 'ArrowDown' ? Math.min(active + 1, vis.length - 1) : Math.max(active - 1, 0);
        opts.forEach((o) => o.classList.remove('is-active'));
        vis[active]?.classList.add('is-active');
        vis[active]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        if (active >= 0 && vis[active]) { e.preventDefault(); select(vis[active].dataset.id!, vis[active].dataset.name!); close(); }
      } else if (e.key === 'Escape') { close(); }
    });
    opts.forEach((o) =>
      o.addEventListener('mousedown', (e) => {
        e.preventDefault();
        select(o.dataset.id!, o.dataset.name!);
        close();
      }),
    );
    document.addEventListener('click', (e) => { if (!ac.contains(e.target as Node)) close(); });

    // External reset (e.g. "Clear filters")
    document.addEventListener('locality:reset', () => { input.value = ''; clearSelection(false); filter(); });

    // Preselect from ?param or static value
    const paramKey = ac.dataset.param;
    const initId = (paramKey && new URLSearchParams(location.search).get(paramKey)) || ac.dataset.value || '';
    if (initId) {
      const o = opts.find((x) => x.dataset.id === initId);
      if (o) select(initId, o.dataset.name!, false);
    }
  });
</script>
