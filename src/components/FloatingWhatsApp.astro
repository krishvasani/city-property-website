---
import { whatsappUrl } from '../lib/config';
interface Props { message?: string; }
const { message = 'Hi City Property Services, I’d like to know more about a property.' } = Astro.props;
const href = whatsappUrl(message);
---
<a class="fab-wa" href={href} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20l1.4-4A8 8 0 1 1 9 19.2L4 20z"/><path d="M9 9c0 4 2 6 6 6"/></svg>
  <span>Chat with us</span>
</a>

<style>
  .fab-wa {
    position: fixed; right: 20px; bottom: 20px; z-index: 60;
    display: inline-flex; align-items: center; gap: 9px;
    padding: 13px 18px 13px 15px; border-radius: var(--r-pill);
    background: #1faf54; color: #fff; font-weight: 600; font-size: 15px;
    box-shadow: var(--shadow-lg);
    transition: transform var(--t-fast) var(--ease), box-shadow var(--t) var(--ease), background var(--t) var(--ease);
  }
  .fab-wa:hover { transform: translateY(-2px); background: #1a9a4a; }
  .fab-wa:active { transform: translateY(0) scale(.98); }
  .fab-wa svg { width: 22px; height: 22px; }
  @media (max-width: 560px) {
    .fab-wa span { display: none; }
    .fab-wa { padding: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fab-wa { transition: background var(--t) var(--ease); }
  }
</style>
