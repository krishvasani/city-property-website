---
import { site, contact, social, whatsappUrl, telUrl } from '../lib/config';
const year = new Date().getFullYear();
const waHref = whatsappUrl('Hi City Property Services, I have a question.');
---
<footer class="footer">
  <div class="wrap-wide">
    <div class="top">
      <div class="brand">
        <img src="/logo/city-property-logo-white.png" alt="City Property Services" />
        <p class="small" style="color:#9aa9b2;max-width:34ch;margin:0;">
          Ahmedabad’s full spectrum property advisors for residential, commercial, land,
          industrial and warehousing.
        </p>
        <div class="foot-contact">
          <a href={telUrl()}>{contact.phone}</a>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </div>
      </div>
      <div>
        <h5>Explore</h5>
        <ul>
          <li><a href="/buy">Buy</a></li>
          <li><a href="/rent">Rent</a></li>
          <li><a href="/map">Map view</a></li>
          <li><a href="/saved">Saved properties</a></li>
        </ul>
      </div>
      <div>
        <h5>Company</h5>
        <ul>
          <li><a href="/sell">Sell your property</a></li>
          <li><a href="/guide">Buyer &amp; seller guide</a></li>
          <li><a href="/blog">Market blog</a></li>
          <li><a href="/consult">Talk to an expert</a></li>
        </ul>
      </div>
      <div>
        <h5>Localities</h5>
        <ul>
          <li><a href="/buy?locality=sg-highway">SG Highway</a></li>
          <li><a href="/buy?locality=satellite">Satellite</a></li>
          <li><a href="/buy?locality=prahlad-nagar">Prahlad Nagar</a></li>
          <li><a href="/buy?locality=bopal">Bopal</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© {year} {site.name} · RERA: {site.rera}</span>
      <div class="social">
        <a href={social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M6.94 8.5v8.04H4.27V8.5h2.67zM5.6 4.2a1.55 1.55 0 1 1 0 3.1 1.55 1.55 0 0 1 0-3.1zM9 8.5h2.56v1.1h.04c.36-.66 1.23-1.36 2.54-1.36 2.71 0 3.21 1.78 3.21 4.09v4.21h-2.67v-3.73c0-.89-.02-2.03-1.24-2.03-1.24 0-1.43.97-1.43 1.97v3.79H9V8.5z"/></svg>
        </a>
        <a href={waHref} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 20l1.4-4A8 8 0 1 1 9 19.2L4 20z"/><path d="M9 9c0 4 2 6 6 6"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot-contact { display: flex; flex-direction: column; gap: 6px; margin-top: 16px; font-size: 14px; }
  .foot-contact a { color: #c4d0d8; font-weight: 600; width: max-content; }
  .foot-contact a:hover { color: #fff; }
</style>
