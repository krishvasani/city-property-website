---
import { site, whatsappUrl } from '../lib/config';
const year = new Date().getFullYear();
const waHref = whatsappUrl('Hi City Property Services, I have a question.');
---
<footer class="footer">
  <div class="wrap-wide">
    <div class="top">
      <div class="brand">
        <img src="/logo/city-property-logo-white.png" alt="City Property Services" />
        <p class="small" style="color:#9aa9b2;max-width:34ch;margin:0;">
          Ahmedabad’s full-spectrum property advisors — residential, commercial, land,
          industrial and warehousing.
        </p>
      </div>
      <div>
        <h5>Explore</h5>
        <ul>
          <li><a href="/listings">Buy</a></li>
          <li><a href="/listings?status=rent">Rent</a></li>
          <li><a href="/listings?type=commercial">Commercial</a></li>
          <li><a href="/listings">New projects</a></li>
        </ul>
      </div>
      <div>
        <h5>Company</h5>
        <ul>
          <li><a href="/#agents">Our agents</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/list-property">List your property</a></li>
          <li><a href="/#">About us</a></li>
        </ul>
      </div>
      <div>
        <h5>Localities</h5>
        <ul>
          <li><a href="/listings?locality=sg-highway">SG Highway</a></li>
          <li><a href="/listings?locality=satellite">Satellite</a></li>
          <li><a href="/listings?locality=prahlad-nagar">Prahlad Nagar</a></li>
          <li><a href="/listings?locality=bopal">Bopal</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© {year} {site.name} · RERA: {site.rera}</span>
      <div class="social">
        <a href="#" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="#" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 8h2V5h-2a3 3 0 0 0-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14V8z"/></svg>
        </a>
        <a href={waHref} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 20l1.4-4A8 8 0 1 1 9 19.2L4 20z"/><path d="M9 9c0 4 2 6 6 6"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
