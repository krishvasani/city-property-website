---
import Icon from './Icon.astro';
import LocalityAutocomplete from './LocalityAutocomplete.astro';
---
<form class="hero-search" action="/buy" method="get" data-hero-search>
  <div class="segment" role="tablist" aria-label="Search mode">
    <button type="button" class="is-active" data-target="/buy">Buy</button>
    <button type="button" data-target="/rent">Rent</button>
  </div>

  <div class="searchbar">
    <div class="seg seg-loc">
      <label for="hero-loc">Location</label>
      <LocalityAutocomplete id="hero-loc" hiddenName="locality" placeholder="Search a locality or area…" />
    </div>
    <div class="seg">
      <label for="hero-type">Type</label>
      <select id="hero-type" name="type">
        <option value="">Any type</option>
        <option value="residential">Residential</option>
        <option value="commercial">Commercial</option>
        <option value="land">Land &amp; plots</option>
        <option value="industrial">Industrial</option>
        <option value="warehousing">Warehousing</option>
      </select>
    </div>
    <div class="seg">
      <label for="hero-budget">Budget</label>
      <select id="hero-budget" name="budget">
        <option value="">Any budget</option>
        <option value="0-5000000">Up to ₹50 L</option>
        <option value="5000000-10000000">₹50 L to 1 Cr</option>
        <option value="10000000-20000000">₹1 to 2 Cr</option>
        <option value="20000000-">₹2 Cr +</option>
      </select>
    </div>
    <button class="btn btn-primary" type="submit" style="align-self:center;">
      <Icon name="search" sw={2} />
      Search
    </button>
  </div>
</form>

<script>
  // The Buy/Rent segment chooses which results page the search submits to.
  document.querySelectorAll<HTMLFormElement>('[data-hero-search]').forEach((form) => {
    const seg = form.querySelector('.segment');
    const budgetSeg = form.querySelector('#hero-budget')?.closest('.seg') as HTMLElement | null;
    if (!seg) return;
    let target = '/buy';

    seg.querySelectorAll('button').forEach((btn) =>
      btn.addEventListener('click', () => {
        seg.querySelectorAll('button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        target = btn.getAttribute('data-target') || '/buy';
        // The sale-oriented budget ranges don't apply to rentals — hide for Rent.
        if (budgetSeg) budgetSeg.style.display = target === '/rent' ? 'none' : '';
      }),
    );

    form.addEventListener('submit', () => {
      form.setAttribute('action', target);
      // Drop an empty locality so the URL stays clean.
      const loc = form.querySelector('.loc-ac-hidden') as HTMLInputElement | null;
      if (loc && !loc.value) loc.removeAttribute('name');
      if (target === '/rent') {
        const b = form.querySelector('#hero-budget') as HTMLSelectElement | null;
        if (b) b.removeAttribute('name'); // drop sale budget from the rent query
      }
    });
  });
</script>
