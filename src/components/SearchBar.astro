---
import Icon from './Icon.astro';
import LocalityAutocomplete from './LocalityAutocomplete.astro';
import { getProperties } from '../lib/data';
import { landingCombos } from '../lib/landing';
import { TYPE_SLUG_CATEGORY } from '../lib/landing-core';

// Route a (buy|rent, locality, category) search straight to its landing page
// when exactly one landing page of that category exists for the locality —
// e.g. Rent + Thaltej + Commercial → /rent/office-space-in-thaltej/ when
// offices are the only commercial type with a page there. Ambiguous or
// unmatched combinations keep the /buy/?locality=… query URL.
const combos = landingCombos(await getProperties());
const byKey = new Map<string, string[]>();
for (const c of combos) {
  const key = `${c.side}|${c.locality.id}|${TYPE_SLUG_CATEGORY[c.typeSlug]}`;
  byKey.set(key, [...(byKey.get(key) ?? []), c.path]);
}
const landings: Record<string, string> = {};
for (const [key, paths] of byKey) if (paths.length === 1) landings[key] = paths[0];
---
<script type="application/json" id="hero-landings" set:html={JSON.stringify(landings)}></script>
<form class="hero-search" action="/buy/" method="get" data-hero-search>
  <div class="segment" role="tablist" aria-label="Search mode">
    <button type="button" class="is-active" data-target="/buy/">Buy</button>
    <button type="button" data-target="/rent/">Rent</button>
  </div>

  <div class="searchbar">
    <div class="seg seg-loc">
      <label for="hero-loc">Location</label>
      <LocalityAutocomplete id="hero-loc" hiddenName="locality" placeholder="Search a locality or area…" />
    </div>
    <div class="seg">
      <label for="hero-type">Type</label>
      <select id="hero-type" name="type">
        <option value="">Any type</option>
        <option value="residential">Residential</option>
        <option value="commercial">Commercial</option>
        <option value="land">Land &amp; plots</option>
        <option value="industrial">Industrial &amp; Warehousing</option>
        <option value="investment">Investments</option>
      </select>
    </div>
    <div class="seg">
      <label for="hero-budget">Budget</label>
      <select id="hero-budget" name="budget">
        <option value="">Any budget</option>
        <option value="0-5000000">Up to ₹50 L</option>
        <option value="5000000-10000000">₹50 L to 1 Cr</option>
        <option value="10000000-20000000">₹1 to 2 Cr</option>
        <option value="20000000-">₹2 Cr +</option>
      </select>
    </div>
    <button class="btn btn-primary" type="submit" style="align-self:center;">
      <Icon name="search" sw={2} />
      Search
    </button>
  </div>
</form>

<script>
  // The Buy/Rent segment chooses which results page the search submits to.
  document.querySelectorAll<HTMLFormElement>('[data-hero-search]').forEach((form) => {
    const seg = form.querySelector('.segment');
    const budgetSeg = form.querySelector('#hero-budget')?.closest('.seg') as HTMLElement | null;
    if (!seg) return;
    let target = '/buy/';

    seg.querySelectorAll('button').forEach((btn) =>
      btn.addEventListener('click', () => {
        seg.querySelectorAll('button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        target = btn.getAttribute('data-target') || '/buy/';
        // The sale-oriented budget ranges don't apply to rentals — hide for Rent.
        if (budgetSeg) budgetSeg.style.display = target === '/rent/' ? 'none' : '';
      }),
    );

    let LANDINGS: Record<string, string> = {};
    try { LANDINGS = JSON.parse(document.getElementById('hero-landings')?.textContent || '{}'); } catch {}

    form.addEventListener('submit', (e) => {
      form.setAttribute('action', target);
      const loc = form.querySelector('.loc-ac-hidden') as HTMLInputElement | null;
      // Locality + type chosen, no budget filter → go straight to the
      // crawlable landing page for that combination when one exists.
      const type = (form.querySelector('#hero-type') as HTMLSelectElement | null)?.value || '';
      const budget = target === '/buy/' ? ((form.querySelector('#hero-budget') as HTMLSelectElement | null)?.value || '') : '';
      const side = target === '/rent/' ? 'rent' : 'buy';
      const landing = loc?.value && type && !budget ? LANDINGS[`${side}|${loc.value}|${type}`] : undefined;
      if (landing) { e.preventDefault(); window.location.href = landing; return; }
      // Drop an empty locality so the URL stays clean.
      if (loc && !loc.value) loc.removeAttribute('name');
      if (target === '/rent/') {
        const b = form.querySelector('#hero-budget') as HTMLSelectElement | null;
        if (b) b.removeAttribute('name'); // drop sale budget from the rent query
      }
    });
  });
</script>
