---
import Icon from './Icon.astro';

interface Props {
  location?: string;
}
const { location = 'SG Highway, Ahmedabad' } = Astro.props;
---
<form class="hero-search" action="/listings" method="get" data-hero-search>
  <div class="segment" role="tablist" aria-label="Search mode">
    <button type="button" class="is-active" data-status="sale">Buy</button>
    <button type="button" data-status="rent">Rent</button>
    <button type="button" data-type="commercial">Commercial</button>
  </div>

  <input type="hidden" name="status" value="sale" />
  <input type="hidden" name="type" value="" />

  <div class="searchbar">
    <div class="seg">
      <label for="hero-loc">Location</label>
      <input id="hero-loc" name="q" value={location} autocomplete="off" />
    </div>
    <div class="seg">
      <label for="hero-type">Type</label>
      <select id="hero-type" name="typeSelect">
        <option value="residential">Residential</option>
        <option value="commercial">Commercial</option>
        <option value="land">Land &amp; plots</option>
        <option value="industrial">Industrial</option>
        <option value="warehousing">Warehousing</option>
      </select>
    </div>
    <div class="seg">
      <label for="hero-budget">Budget</label>
      <select id="hero-budget" name="budget">
        <option value="0-5000000">Up to ₹50 L</option>
        <option value="5000000-10000000">₹50 L – 1 Cr</option>
        <option value="10000000-20000000">₹1 – 2 Cr</option>
        <option value="20000000-">₹2 Cr +</option>
      </select>
    </div>
    <button class="btn btn-primary" type="submit" style="align-self:center;">
      <Icon name="search" sw={2} />
      Search
    </button>
  </div>
</form>

<script>
  // Wire the Buy/Rent/Commercial segment to hidden status/type inputs.
  document.querySelectorAll('[data-hero-search]').forEach((form) => {
    const seg = form.querySelector('.segment');
    const statusInput = form.querySelector('input[name="status"]') as HTMLInputElement;
    const typeInput = form.querySelector('input[name="type"]') as HTMLInputElement;
    const typeSelect = form.querySelector('select[name="typeSelect"]') as HTMLSelectElement;
    if (!seg) return;

    const apply = (btn: Element) => {
      const status = btn.getAttribute('data-status') || '';
      const type = btn.getAttribute('data-type') || '';
      statusInput.value = status;
      typeInput.value = type;
    };
    seg.querySelectorAll('button').forEach((btn) =>
      btn.addEventListener('click', () => apply(btn)),
    );
    // On submit, prefer the Type dropdown unless the segment forced Commercial.
    form.addEventListener('submit', () => {
      if (!typeInput.value && typeSelect?.value) typeInput.value = typeSelect.value;
      typeSelect.removeAttribute('name'); // keep the URL clean
    });
  });
</script>
