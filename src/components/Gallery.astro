---
import type { Photo } from '../lib/types';

interface Props {
  photos?: Photo[];
  totalCount?: number;
}
const { photos = [] } = Astro.props;

// Only real uploaded photos can open full screen; the rest are placeholders.
const real: Photo[] = photos.filter((p) => p.url && p.url.trim());

// Keep the 5-cell hero layout; fill with real photos, pad with placeholders.
const fallbackLabels = Array(5).fill('Contact for details');
const cells = Array.from({ length: 5 }, (_, i) => ({
  photo: real[i] as Photo | undefined,
  label: fallbackLabels[i],
  // index into the real-photo list (for the lightbox), or null for placeholders
  lbIndex: real[i] ? i : null,
}));
const count = real.length;
---
<section class:list={['gallery', { 'gallery-none': count === 0 }]} data-gallery>
  {count === 0 ? (
    <div class="ph ph-contact">
      <div class="ph-contact-inner">
        <strong>Photos available on request</strong>
        <p>Contact City Property Services for photos, floor plans and the full details of this property.</p>
        <a class="btn btn-primary btn-sm" href="#enquire">Contact for details</a>
      </div>
    </div>
  ) : cells.map((cell, i) => (
    <div
      class:list={['cell', { g0: i === 0, clickable: cell.lbIndex !== null }]}
      data-lb-index={cell.lbIndex !== null ? cell.lbIndex : undefined}
      role={cell.lbIndex !== null ? 'button' : undefined}
      tabindex={cell.lbIndex !== null ? '0' : undefined}
      aria-label={cell.lbIndex !== null ? 'Open photo' : undefined}
    >
      {cell.photo ? (
        <img src={cell.photo.url} alt={cell.photo.alt ?? cell.photo.label ?? 'Property photo'} loading={i === 0 ? 'eager' : 'lazy'} />
      ) : (
        <div class="ph" data-label={cell.label}></div>
      )}
      {i === 4 && count > 1 && (
        <button class="btn btn-secondary btn-sm more" type="button" data-lb-open>View all {count} photos</button>
      )}
    </div>
  ))}

  {count > 0 && (
    <div class="lb" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Property photos">
      <button class="lb-btn lb-close" type="button" data-lb-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      {real.length > 1 && (
        <button class="lb-btn lb-nav lb-prev" type="button" data-lb-prev aria-label="Previous photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
        </button>
      )}
      <div class="lb-stage">
        {real.map((p, i) => (
          <img class:list={['lb-img', { 'is-active': i === 0 }]} src={p.url} alt={p.alt ?? p.label ?? 'Property photo'} data-lb-img={i} />
        ))}
      </div>
      {real.length > 1 && (
        <button class="lb-btn lb-nav lb-next" type="button" data-lb-next aria-label="Next photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      )}
      {real.length > 1 && (
        <div class="lb-counter"><span data-lb-cur>1</span> / {real.length}</div>
      )}
    </div>
  )}
</section>

<style>
  .gallery .cell img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--t-slow) var(--ease-out); }
  .gallery .cell.clickable { cursor: zoom-in; }
  .gallery .cell.clickable:hover img { transform: scale(1.04); }
  .gallery .cell .ph { height: 100%; }
  .gallery .more { position: absolute; right: 12px; bottom: 12px; z-index: 2; }

  /* Photo-less property: a clear contact prompt instead of empty placeholder cells */
  .gallery-none { display: block; height: auto; }
  .gallery-none .ph-contact { min-height: clamp(220px, 38vw, 380px); border-radius: var(--r-xl); padding: 36px 28px; }
  .ph-contact-inner { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; max-width: 46ch; }
  .ph-contact-inner strong { font-size: 19px; font-weight: 700; color: var(--ink); }
  .ph-contact-inner p { font-size: 15px; color: var(--text-muted); line-height: 1.55; margin: 0; }
  .ph-contact-inner .btn { margin-top: 4px; }

  /* Full screen lightbox */
  .lb { position: fixed; inset: 0; z-index: 200; background: rgba(9, 16, 22, .95); display: none; align-items: center; justify-content: center; }
  .lb.is-open { display: flex; }
  .lb-stage { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 64px 16px; box-sizing: border-box; }
  .lb-img { max-width: min(96vw, 1400px); max-height: 86vh; object-fit: contain; border-radius: 8px; display: none; }
  .lb-img.is-active { display: block; }
  .lb-btn { position: fixed; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 999px; border: none; background: rgba(255, 255, 255, .14); color: #fff; cursor: pointer; backdrop-filter: blur(6px); transition: background .15s ease, transform .15s ease; }
  .lb-btn:hover { background: rgba(255, 255, 255, .26); }
  .lb-btn:active { transform: scale(.94); }
  .lb-btn svg { width: 22px; height: 22px; }
  .lb-close { top: 16px; right: 16px; }
  .lb-nav { top: 50%; transform: translateY(-50%); }
  .lb-nav:active { transform: translateY(-50%) scale(.94); }
  .lb-prev { left: 14px; }
  .lb-next { right: 14px; }
  .lb-counter { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); color: #fff; font-size: 14px; font-weight: 600; background: rgba(0, 0, 0, .35); padding: 6px 14px; border-radius: 999px; }
  @media (max-width: 560px) {
    .lb-stage { padding: 56px 8px; }
    .lb-btn { width: 42px; height: 42px; }
    .lb-prev { left: 8px; }
    .lb-next { right: 8px; }
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const lb = gallery?.querySelector<HTMLElement>('[data-lightbox]');
  if (gallery && lb) {
    const imgs = Array.from(lb.querySelectorAll<HTMLElement>('.lb-img'));
    const curEl = lb.querySelector<HTMLElement>('[data-lb-cur]');
    let idx = 0;

    const show = (i: number) => {
      idx = (i + imgs.length) % imgs.length;
      imgs.forEach((im, k) => im.classList.toggle('is-active', k === idx));
      if (curEl) curEl.textContent = String(idx + 1);
    };
    const open = (i: number) => {
      if (!imgs.length) return;
      show(i);
      lb.hidden = false;
      requestAnimationFrame(() => lb.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.classList.remove('is-open');
      lb.hidden = true;
      document.body.style.overflow = '';
    };
    const next = () => show(idx + 1);
    const prev = () => show(idx - 1);

    gallery.querySelectorAll<HTMLElement>('[data-lb-index]').forEach((cell) => {
      const i = Number(cell.dataset.lbIndex);
      cell.addEventListener('click', () => open(i));
      cell.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(i); }
      });
    });
    gallery.querySelector('[data-lb-open]')?.addEventListener('click', (e) => {
      e.stopPropagation(); // don't also trigger the cell it sits inside
      open(0);
    });
    lb.querySelector('[data-lb-close]')?.addEventListener('click', close);
    lb.querySelector('[data-lb-next]')?.addEventListener('click', next);
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', prev);
    // Click the dark backdrop (not the image) to close.
    lb.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).classList.contains('lb-stage') || e.target === lb) close();
    });
    window.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
    });
    // Swipe on touch devices.
    let sx = 0;
    lb.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 45) (dx < 0 ? next : prev)();
    }, { passive: true });
  }
</script>
