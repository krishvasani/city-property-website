---
import { whatsappUrl } from '../lib/config';
import type { Agent } from '../lib/types';

interface Props {
  agent: Agent;
  variant?: 'card' | 'row';
}
const { agent, variant = 'card' } = Astro.props;

const homeSubtitle = agent.region ? `${agent.role} · ${agent.region}` : agent.role;
const rowSubtitle = [agent.role, agent.exp, agent.region].filter(Boolean).join(' · ');
const waHref = whatsappUrl(`Hi ${agent.name}, I’d like to talk about a property.`, agent.whatsapp);
const avatarUrl = agent.avatar?.url;
---
{variant === 'row' ? (
  <div class="agent">
    {avatarUrl ? (
      <img class="avatar" src={avatarUrl} alt={agent.name} />
    ) : (
      <div class="ph avatar" data-label="" style="border-radius:999px;"></div>
    )}
    <div class="info">
      <div class="nm">{agent.name}</div>
      <div class="rl">{rowSubtitle}</div>
    </div>
    <a class="btn btn-primary btn-sm" href={waHref} target="_blank" rel="noopener">Contact</a>
  </div>
) : (
  <div class="agent-card">
    {avatarUrl ? (
      <img class="av" src={avatarUrl} alt={agent.name} style="border-radius:999px;object-fit:cover;" />
    ) : (
      <div class="ph av" data-label=""></div>
    )}
    <div class="h4">{agent.name}</div>
    <div class="small muted">{homeSubtitle}</div>
    <div class="row" style="justify-content:center;margin-top:16px;">
      <a class="btn btn-secondary btn-sm" href="/consult">Profile</a>
      <a class="btn btn-primary btn-sm" href={waHref} target="_blank" rel="noopener">Contact</a>
    </div>
  </div>
)}
