---
import { emiMonthly, formatINRShort } from '../lib/format';

interface Props {
  priceValue?: number;
  /** The price as shown on the page, e.g. "₹5.38 to 18.04 Cr" — shown as a hint when it is a range. */
  priceDisplay?: string;
  rate?: number;
  years?: number;
  ltv?: number; // loan-to-value %
}
const { priceValue = 14_500_000, priceDisplay, rate = 8.5, years = 20, ltv = 80 } = Astro.props;
const isRange = !!priceDisplay && /\bto\b|onwards|from/i.test(priceDisplay);

const loan = (priceValue * ltv) / 100;
const emi = Math.round(emiMonthly(loan, rate, years));
const emiDisplay = `₹ ${emi.toLocaleString('en-IN')}`;
const loanDisplay = formatINRShort(loan);
---
<div class="emi" data-emi data-price={priceValue}>
  <div class="emi-grid">
    <div class="emi-summary">
      <div class="emi-top">
        <span class="small muted">Est. EMI</span>
        <span class="mono small" data-emi-terms>@ {rate}% · {years} yr</span>
      </div>
      <div class="emi-value"><span data-emi-value>{emiDisplay}</span><span class="per"> /mo</span></div>
      <div class="caption muted">On <span data-emi-ltv>{ltv}</span>% loan of <span data-emi-loan>{loanDisplay}</span>. Indicative only.</div>
    </div>

    <div class="emi-calc">
      <label class="emi-ctl emi-price">
        <span>Property price <b data-out="price">{formatINRShort(priceValue)}</b></span>
        <input type="text" name="price" inputmode="decimal" value={formatINRShort(priceValue).replace('₹', '')} aria-label="Property price" autocomplete="off" />
        <small class="muted">{isRange ? `Listed at ${priceDisplay} — enter the quote for your unit (e.g. 6.5 Cr or 65000000).` : 'Edit to try a different price (e.g. 1.2 Cr, 85 L or 8500000).'}</small>
      </label>
      <label class="emi-ctl">
        <span>Interest rate <b data-out="rate">{rate}%</b></span>
        <input type="range" name="rate" min="6" max="12" step="0.1" value={rate} />
      </label>
      <label class="emi-ctl">
        <span>Tenure <b data-out="years">{years} yr</b></span>
        <input type="range" name="years" min="5" max="30" step="1" value={years} />
      </label>
      <label class="emi-ctl">
        <span>Loan to value <b data-out="ltv">{ltv}%</b></span>
        <input type="range" name="ltv" min="10" max="100" step="5" value={ltv} />
      </label>
    </div>
  </div>
</div>

<style>
  .emi { background: var(--navy-tint); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 24px; }
  .emi-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 30px; align-items: center; }
  .emi-summary { min-width: 0; }
  .emi-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .emi-top [data-emi-terms] { color: var(--navy); font-weight: 600; }
  .emi-value { font-size: clamp(26px, 2.6vw, 32px); font-weight: 650; color: var(--ink); letter-spacing: -.02em; margin: 6px 0 4px; line-height: 1.1; }
  .emi-value .per { font-size: 14px; font-weight: 500; color: var(--text-muted); }
  .emi-calc { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .emi-ctl { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--text-muted); }
  .emi-ctl > span { display: flex; justify-content: space-between; gap: 10px; }
  .emi-ctl b { color: var(--ink); font-weight: 600; }
  .emi-ctl input[type="range"] { width: 100%; accent-color: var(--navy); }
  .emi-price input[type="text"] { width: 100%; padding: 9px 12px; border: 1px solid var(--border); border-radius: var(--r-sm); font: inherit; font-size: 15px; font-weight: 600; color: var(--ink); background: var(--surface); }
  .emi-price input[type="text"]:focus { outline: 2px solid var(--navy); outline-offset: 1px; }
  .emi-price small { font-size: 12px; line-height: 1.4; }
  /* stack on narrow columns / mobile */
  @media (max-width: 620px) { .emi-grid { grid-template-columns: 1fr; gap: 20px; } }
</style>

<script>
  function fmtShort(r: number) {
    if (r >= 1e7) return `₹${(r / 1e7).toFixed(2).replace(/\.00$/, '')} Cr`;
    if (r >= 1e5) return `₹${Math.round(r / 1e5)} L`;
    return `₹${Math.round(r).toLocaleString('en-IN')}`;
  }
  function emi(p: number, rate: number, years: number) {
    const r = rate / 12 / 100, n = years * 12;
    const pow = Math.pow(1 + r, n);
    return (p * r * pow) / (pow - 1);
  }
  // "6.5 Cr", "85 L", "85 lakh", "₹65,00,000", "6500000" → rupees
  function parsePrice(raw: string): number {
    const t = raw.toLowerCase().replace(/[₹,\s]/g, '');
    const m = t.match(/^([\d.]+)(cr|crore|crores|l|lac|lacs|lakh|lakhs)?$/);
    if (!m) return NaN;
    const n = parseFloat(m[1]); const u = m[2] || '';
    return u.startsWith('cr') ? n * 1e7 : u ? n * 1e5 : n;
  }
  document.querySelectorAll<HTMLElement>('[data-emi]').forEach((card) => {
    let price = parseFloat(card.getAttribute('data-price') || '0');
    const priceInput = card.querySelector<HTMLInputElement>('input[name="price"]');
    const priceOut = card.querySelector('[data-out="price"]');
    const valueEl = card.querySelector('[data-emi-value]');
    const termsEl = card.querySelector('[data-emi-terms]');
    const loanEl = card.querySelector('[data-emi-loan]');
    const ltvEl = card.querySelector('[data-emi-ltv]');
    const inputs = card.querySelectorAll<HTMLInputElement>('input[type="range"]');

    const recompute = () => {
      const vals: Record<string, number> = {};
      inputs.forEach((i) => (vals[i.name] = parseFloat(i.value)));
      const { rate, years, ltv } = vals;
      const loan = (price * ltv) / 100;
      const monthly = Math.round(emi(loan, rate, years));
      valueEl && (valueEl.textContent = `₹ ${monthly.toLocaleString('en-IN')}`);
      termsEl && (termsEl.textContent = `@ ${rate}% · ${years} yr`);
      loanEl && (loanEl.textContent = fmtShort(loan));
      ltvEl && (ltvEl.textContent = `${ltv}`);
      card.querySelector('[data-out="rate"]')!.textContent = `${rate}%`;
      card.querySelector('[data-out="years"]')!.textContent = `${years} yr`;
      card.querySelector('[data-out="ltv"]')!.textContent = `${ltv}%`;
    };
    inputs.forEach((i) => i.addEventListener('input', recompute));
    priceInput?.addEventListener('input', () => {
      const v = parsePrice(priceInput.value);
      if (!isFinite(v) || v <= 0) { priceInput.setAttribute('aria-invalid', 'true'); return; }
      priceInput.removeAttribute('aria-invalid');
      price = v; priceOut && (priceOut.textContent = fmtShort(v)); recompute();
    });
    priceInput?.addEventListener('blur', () => { if (isFinite(price) && price > 0) priceInput.value = fmtShort(price).replace('₹', ''); });
  });
</script>
