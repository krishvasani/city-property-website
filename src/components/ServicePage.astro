---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import PropertyCard from '../components/PropertyCard.astro';
import Icon from '../components/Icon.astro';
import { serviceLinks } from '../lib/services';
import { getProperties } from '../lib/data';
import { categoryFor } from '../lib/format';
import { site } from '../lib/config';

interface HelpItem { title: string; text: string }
interface ExtraSection { heading: string; intro?: string; items?: string[] }

interface Props {
  serviceKey: string;
  seoTitle: string;
  seoDescription: string;
  eyebrow: string;
  heading: string;
  intro: string;
  lead?: string[];
  helpTitle?: string;
  helpItems: string[];
  idealTitle?: string;
  idealFor: string[];
  supportTitle?: string;
  support: HelpItem[];
  extra?: ExtraSection[];
  ctaLabel: string;
  formIntent: string;
  sizeHint?: string;
  relatedCategory?: string | null;
}

const {
  serviceKey,
  seoTitle,
  seoDescription,
  eyebrow,
  heading,
  intro,
  lead = [],
  helpTitle = 'What we help with',
  helpItems,
  idealTitle = 'Ideal for',
  idealFor,
  supportTitle = 'How we support you',
  support,
  extra = [],
  ctaLabel,
  formIntent,
  sizeHint = 'e.g. budget or size you have in mind (optional)',
  relatedCategory = null,
} = Astro.props;

// Service interest options, with this page's service preselected (first).
const otherServices = serviceLinks.map((s) => s.label).filter((l) => l !== formIntent);
const intentOptions = [formIntent, ...otherServices];

// Optional related listings from the property data, plus a "Browse all" link
// that lands on this vertical's filtered results (Buy if any are for sale,
// else Rent — e.g. warehouses are lease-only), not the unfiltered Buy page.
let related: Awaited<ReturnType<typeof getProperties>> = [];
let browseHref = '/buy';
if (relatedCategory) {
  const all = await getProperties();
  const inCat = all.filter((p) => categoryFor(p.propertyType) === relatedCategory);
  related = inCat.slice(0, 3);
  const page = inCat.some((p) => p.status === 'sale')
    ? 'buy'
    : inCat.some((p) => p.status === 'rent' || p.status === 'lease')
      ? 'rent'
      : 'buy';
  browseHref = `/${page}?type=${relatedCategory}`;
}

const otherLinks = serviceLinks.filter((s) => s.key !== serviceKey);

// ── SEO: Service schema + breadcrumbs ──
const serviceUrl = new URL(Astro.url.pathname, site.url).href;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: heading, url: Astro.url.pathname },
];
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: heading,
  description: seoDescription,
  serviceType: heading,
  url: serviceUrl,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: [
    { '@type': 'City', name: 'Ahmedabad' },
    { '@type': 'City', name: 'Gandhinagar' },
  ],
};
---
<Base title={seoTitle} description={seoDescription} active="services" breadcrumbs={breadcrumbs} jsonLd={serviceSchema}>
  <main class="wrap">
    <section class="page-hero svc-hero">
      <div class="eyebrow">{eyebrow}</div>
      <h1 class="display" style="max-width:18ch;margin-top:12px;">{heading}</h1>
      <p class="body-lg muted" style="max-width:62ch;margin-top:18px;">{intro}</p>
      <div class="svc-hero-cta">
        <a class="btn btn-primary" href="#inquiry">{ctaLabel}</a>
        <a class="btn btn-secondary" href="/consult">Talk to our team</a>
      </div>
    </section>

    {lead.length > 0 && (
      <section class="svc-lead">
        {lead.map((p) => <p>{p}</p>)}
      </section>
    )}

    <section class="svc-block">
      <h2 class="h2">{helpTitle}</h2>
      <div class="svc-help">
        {helpItems.map((it) => (
          <div class="svc-help-item"><span class="ck"><Icon name="check" sw={2.4} /></span><span>{it}</span></div>
        ))}
      </div>
    </section>

    <section class="svc-block">
      <h2 class="h2">{idealTitle}</h2>
      <div class="svc-chips">
        {idealFor.map((i) => <span class="svc-chip">{i}</span>)}
      </div>
    </section>

    <section class="svc-block">
      <h2 class="h2">{supportTitle}</h2>
      <ol class="svc-steps">
        {support.map((s, i) => (
          <li><span class="n">{i + 1}</span><div><b>{s.title}</b><span class="muted">{s.text}</span></div></li>
        ))}
      </ol>
    </section>

    {extra.map((sec) => (
      <section class="svc-block">
        <h2 class="h2">{sec.heading}</h2>
        {sec.intro && <p class="muted svc-sec-intro">{sec.intro}</p>}
        {sec.items && (
          <div class="svc-help">
            {sec.items.map((it) => (
              <div class="svc-help-item"><span class="ck"><Icon name="check" sw={2.4} /></span><span>{it}</span></div>
            ))}
          </div>
        )}
      </section>
    ))}

    {related.length > 0 && (
      <section class="svc-block">
        <div class="svc-rel-head">
          <h2 class="h2">A few current listings</h2>
          <a class="link-arrow" href={browseHref}>Browse all <Icon name="arrowRight" sw={2} /></a>
        </div>
        <div class="svc-rel-grid">
          {related.map((p) => <PropertyCard property={p} />)}
        </div>
      </section>
    )}

    <!-- INQUIRY -->
    <section class="svc-inquiry" id="inquiry">
      <div class="svc-form-panel">
        <h2 class="h2" style="margin-bottom:6px;">{ctaLabel}</h2>
        <p class="muted" style="margin:0 0 18px;">Share a few details and our team will get back to you, usually the same day.</p>
        <LeadForm
          name="service-enquiry"
          submitLabel={ctaLabel}
          twoCol
          intentOptions={intentOptions}
          intentLabel="Service interest"
          extraFields={[
            { name: 'locality', label: 'Preferred locality', type: 'locality', optional: true, placeholder: 'Type a locality, e.g. Prahlad Nagar, Changodar, GIFT City…', full: true },
            { name: 'requirement', label: 'Budget or size requirement', type: 'text', optional: true, placeholder: sizeHint, full: true },
          ]}
          context={{ source: `service:${serviceKey}` }}
          messagePlaceholder="Tell us what you’re looking for and we’ll take it from there…"
          successMessage="Thanks! Your enquiry is in and our team will reach out shortly."
          whatsappFallback={`Hi, I’m interested in your ${formIntent} services.`}
        />
      </div>
      <aside class="svc-side">
        <div class="svc-side-card">
          <h3>Explore more services</h3>
          <div class="svc-side-links">
            {otherLinks.map((s) => (
              <a href={s.href}><Icon name={s.icon as any} sw={1.7} />{s.label}</a>
            ))}
          </div>
          <a class="btn btn-secondary btn-block" href="/services" style="margin-top:14px;">See all services</a>
        </div>
      </aside>
    </section>
  </main>
</Base>

<style is:global>
  .svc-hero { padding: 64px 0 8px; }
  .svc-hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .svc-lead { max-width: 70ch; padding: 18px 0 8px; display: flex; flex-direction: column; gap: 14px; }
  .svc-lead p { font-size: 16px; color: var(--text); line-height: 1.7; margin: 0; }
  .svc-block { padding: 34px 0 0; }
  .svc-block .h2 { font-size: 24px; margin-bottom: 18px; }
  .svc-sec-intro { max-width: 66ch; margin: 0 0 18px; }
  .svc-help { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 28px; }
  .svc-help-item { display: flex; gap: 12px; align-items: flex-start; font-size: 15px; color: var(--text); line-height: 1.55; }
  .svc-help-item .ck { width: 24px; height: 24px; border-radius: 999px; background: var(--good-tint); color: var(--good); display: grid; place-items: center; flex: none; margin-top: 1px; }
  .svc-help-item .ck svg { width: 14px; height: 14px; }
  .svc-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .svc-chip { padding: 9px 16px; border-radius: var(--r-pill); background: var(--navy-tint); color: var(--navy); font-size: 14px; font-weight: 600; border: 1px solid var(--border); }
  .svc-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; max-width: 820px; }
  .svc-steps li { display: flex; gap: 16px; padding: 18px 20px; border: 1px solid var(--hairline); border-radius: var(--r); background: var(--surface); box-shadow: var(--shadow-xs); }
  .svc-steps .n { width: 30px; height: 30px; border-radius: 999px; background: var(--navy); color: #fff; font-weight: 700; font-size: 14px; display: grid; place-items: center; flex: none; }
  .svc-steps b { color: var(--ink); display: block; }
  .svc-steps .muted { display: block; font-size: 14.5px; margin-top: 3px; line-height: 1.55; }
  .svc-rel-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
  .svc-rel-head .h2 { margin: 0; }
  .link-arrow { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 14px; color: var(--navy); flex: none; }
  .link-arrow svg { width: 16px; height: 16px; }
  .svc-rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  .svc-inquiry { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: start; padding: 44px 0 96px; margin-top: 20px; }
  /* grid/flex children must be allowed to shrink below their content width */
  .svc-inquiry > *, .svc-form-panel, .svc-side, .svc-help-item, .svc-help-item > span, .svc-steps li > div { min-width: 0; }
  .svc-side-links a { overflow-wrap: anywhere; }
  .svc-form-panel { background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); padding: 28px; }
  .svc-side { position: sticky; top: calc(var(--nav-h) + 20px); }
  .svc-side-card { background: var(--navy-tint); border: 1px solid var(--hairline); border-radius: var(--r-lg); padding: 22px; }
  .svc-side-card h3 { font-size: 16px; color: var(--ink); margin-bottom: 14px; }
  .svc-side-links { display: flex; flex-direction: column; gap: 2px; }
  .svc-side-links a { display: flex; align-items: center; gap: 11px; padding: 10px 10px; border-radius: var(--r-xs); font-size: 14.5px; font-weight: 600; color: var(--text); }
  .svc-side-links a:hover { background: var(--surface); color: var(--navy); }
  .svc-side-links svg { width: 18px; height: 18px; color: var(--navy); flex: none; }

  @media (max-width: 1100px) { .svc-rel-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 980px) { .svc-inquiry { grid-template-columns: 1fr; } .svc-side { position: static; } }
  @media (max-width: 680px) { .svc-help { grid-template-columns: 1fr; } .svc-rel-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .svc-hero-cta { flex-direction: column; align-items: stretch; }
    .svc-hero-cta .btn { width: 100%; }
    .svc-block .h2 { font-size: 21px; }
    .svc-form-panel { padding: 20px; }
    .svc-inquiry { padding: 32px 0 72px; }
  }
</style>
