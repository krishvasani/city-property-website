---
import Icon from './Icon.astro';
import { serviceLinks } from '../lib/services';

interface Props {
  variant?: 'site' | 'guide';
  active?: string;
}
const { variant = 'site', active } = Astro.props;

// Primary navigation. Consult is the standout CTA (rendered as the button).
const siteLinks = [
  { key: 'buy', label: 'Buy', href: '/buy' },
  { key: 'rent', label: 'Rent', href: '/rent' },
  { key: 'sell', label: 'Sell', href: '/sell' },
  { key: 'map', label: 'Map', href: '/map' },
  { key: 'guide', label: 'Guide', href: '/guide' },
  { key: 'blog', label: 'Blog', href: '/blog' },
  { key: 'about', label: 'About Us', href: '/about-us' },
];
const guideLinks = [
  { key: 'foundations', label: 'Foundations', href: '#foundations' },
  { key: 'components', label: 'Components', href: '#components' },
  { key: 'screens', label: 'Screens', href: '#screens' },
];
const links = variant === 'guide' ? guideLinks : siteLinks;
---
<header class="nav">
  <div class="wrap-wide inner">
    <a class="brand" href="/">
      <img src="/logo/city-property-logo-navy.png" alt="City Property Services" />
    </a>

    {variant === 'guide' && <div class="spacer"></div>}

    <nav class="links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class={active === l.key ? 'active' : undefined}>{l.label}</a>
      ))}
      {variant === 'site' && (
        <div class="nav-services" data-services>
          <a
            href="/services"
            class:list={['nav-services-toggle', { active: active === 'services' }]}
            aria-haspopup="true"
            aria-expanded="false"
          >
            Our Services<Icon name="chevron" sw={2} />
          </a>
          <div class="nav-services-menu" role="menu">
            {serviceLinks.map((s) => (
              <a role="menuitem" href={s.href}><Icon name={s.icon as any} sw={1.7} />{s.label}</a>
            ))}
          </div>
        </div>
      )}
    </nav>

    {variant === 'site' && <div class="spacer"></div>}

    <div class="actions">
      {variant === 'site' && (
        <a class="nav-wish" href="/saved" aria-label="Saved properties">
          <Icon name="heart" sw={1.8} />
          <span class="wish-count" data-wish-count hidden>0</span>
        </a>
      )}
      {variant === 'guide' ? (
        <a class="btn btn-secondary btn-sm" href="/">View site</a>
      ) : (
        <a class:list={['btn', 'btn-primary', 'btn-sm', 'hide-sm', { active: active === 'consult' }]} href="/consult">Consult</a>
      )}
      <button class="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
        <Icon name="menu" sw={1.8} />
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="nav-drawer" id="mobile-drawer" hidden>
    <div class="nav-drawer-panel">
      <nav class="nav-drawer-links" aria-label="Mobile">
        {links.map((l) => <a href={l.href} class={active === l.key ? 'active' : undefined}>{l.label}</a>)}
        {variant === 'site' && <a href="/consult" class={active === 'consult' ? 'active' : undefined}>Consult</a>}
        {variant === 'site' && (
          <div class="drawer-services">
            <a href="/services" class:list={['drawer-services-h', { active: active === 'services' }]}>Our Services</a>
            <div class="drawer-services-list">
              {serviceLinks.map((s) => <a href={s.href}><Icon name={s.icon as any} sw={1.7} />{s.label}</a>)}
            </div>
          </div>
        )}
        {variant === 'site' && <a href="/saved">Saved properties</a>}
      </nav>
      {variant === 'site' && (
        <div class="nav-drawer-actions">
          <a class="btn btn-primary btn-block" href="/consult">Talk to an expert</a>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .nav-burger {
    display: none;
    width: 44px; height: 44px; border-radius: var(--r-pill);
    border: 1px solid var(--border); background: var(--surface);
    color: var(--ink); cursor: pointer; place-items: center;
    box-shadow: var(--shadow-xs);
    transition: border-color var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .nav-burger:hover { border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
  .nav-burger :global(svg) { width: 20px; height: 20px; }

  /* Wishlist / liked button */
  .nav-wish {
    position: relative; display: inline-grid; place-items: center;
    width: 40px; height: 40px; border-radius: var(--r-pill);
    border: 1px solid var(--border); background: var(--surface); color: var(--ink);
    box-shadow: var(--shadow-xs); flex: none;
    transition: border-color var(--t) var(--ease), color var(--t) var(--ease), box-shadow var(--t) var(--ease), transform var(--t) var(--ease);
  }
  .nav-wish:hover { border-color: var(--navy); color: var(--navy); box-shadow: var(--shadow-sm); transform: translateY(-1px); }
  .nav-wish :global(svg) { width: 19px; height: 19px; }
  .nav-wish.has-saved { color: #d6566a; border-color: #f0c9d0; }
  .wish-count {
    position: absolute; top: -6px; right: -6px; min-width: 18px; height: 18px;
    padding: 0 5px; border-radius: 999px; background: var(--navy); color: #fff;
    font-size: 11px; font-weight: 700; line-height: 18px; text-align: center;
    box-shadow: 0 0 0 2px var(--bg);
  }

  .nav-drawer {
    position: fixed; inset: var(--nav-h) 0 0 0; z-index: 49;
    background: rgba(13, 26, 35, 0.34);
    backdrop-filter: blur(2px);
    opacity: 0; pointer-events: none; transition: opacity var(--t) var(--ease);
  }
  .nav-drawer.is-open { opacity: 1; pointer-events: auto; }
  .nav-drawer-panel {
    background: rgba(238, 241, 245, 0.96);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--hairline);
    box-shadow: var(--shadow);
    padding: 14px 24px 22px;
    transform: translateY(-12px); transition: transform var(--t) var(--ease-out);
  }
  .nav-drawer.is-open .nav-drawer-panel { transform: none; }
  .nav-drawer-links { display: flex; flex-direction: column; gap: 2px; }
  .nav-drawer-links > a {
    padding: 13px 12px; border-radius: var(--r-sm); font-size: 16px;
    font-weight: 550; color: var(--text);
  }
  .nav-drawer-links > a:hover { background: var(--surface-2); color: var(--ink); }
  .nav-drawer-links > a.active { color: var(--navy); }
  .nav-drawer-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }

  /* Desktop "Our Services" dropdown */
  .nav-services { position: relative; }
  .nav-services-toggle {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 9px 14px; border-radius: var(--r-sm); font-size: 14.5px;
    font-weight: 550; color: var(--text); cursor: pointer;
    transition: background var(--t) var(--ease), color var(--t) var(--ease);
  }
  .nav-services-toggle:hover { background: var(--surface-2); color: var(--ink); }
  .nav-services-toggle.active { color: var(--navy); }
  .nav-services-toggle :global(svg) { width: 15px; height: 15px; transition: transform var(--t) var(--ease); }
  .nav-services:hover .nav-services-toggle :global(svg),
  .nav-services:focus-within .nav-services-toggle :global(svg) { transform: rotate(180deg); }
  .nav-services-menu {
    position: absolute; top: 100%; left: 0; min-width: 234px;
    padding: 6px; margin-top: 8px;
    background: var(--surface); border: 1px solid var(--hairline);
    border-radius: var(--r); box-shadow: var(--shadow-lg);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity var(--t) var(--ease), transform var(--t) var(--ease), visibility var(--t) var(--ease);
    z-index: 60;
  }
  /* invisible bridge so the cursor can cross the gap without closing */
  .nav-services-menu::before { content: ""; position: absolute; top: -10px; left: 0; right: 0; height: 10px; }
  .nav-services:hover .nav-services-menu,
  .nav-services:focus-within .nav-services-menu { opacity: 1; visibility: visible; transform: none; }
  .nav-services-menu a {
    display: flex; align-items: center; gap: 11px; padding: 9px 12px;
    border-radius: var(--r-xs); font-size: 14px; font-weight: 550;
    color: var(--text); white-space: nowrap;
  }
  .nav-services-menu a:hover { background: var(--navy-tint); color: var(--navy); }
  .nav-services-menu :global(svg) { width: 18px; height: 18px; color: var(--navy); flex: none; }

  /* Mobile drawer "Our Services" group */
  .drawer-services { margin: 6px 0; padding: 8px 0; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .drawer-services-h { display: block; padding: 13px 12px; font-size: 16px; font-weight: 650; color: var(--ink); }
  .drawer-services-h.active { color: var(--navy); }
  .drawer-services-list { display: flex; flex-direction: column; }
  .drawer-services-list a { display: flex; align-items: center; gap: 11px; padding: 11px 12px 11px 22px; border-radius: var(--r-sm); font-size: 15px; font-weight: 550; color: var(--text); }
  .drawer-services-list a:hover { background: var(--surface-2); color: var(--ink); }
  .drawer-services-list :global(svg) { width: 17px; height: 17px; color: var(--navy); flex: none; }

  @media (max-width: 1024px) {
    .nav-burger { display: grid; }
    .hide-sm { display: none; }
  }
</style>

<script>
  // Mobile drawer toggle (progressive enhancement; nav links hide < 860px).
  document.querySelectorAll('.nav').forEach((nav) => {
    const burger = nav.querySelector('.nav-burger');
    const drawer = nav.querySelector('.nav-drawer');
    if (!burger || !drawer) return;
    const setOpen = (open: boolean) => {
      drawer.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      if (open) drawer.removeAttribute('hidden');
      else setTimeout(() => drawer.setAttribute('hidden', ''), 240);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () =>
      setOpen(burger.getAttribute('aria-expanded') !== 'true'),
    );
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) setOpen(false);
    });
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  });

  // Desktop "Our Services" dropdown: keep aria-expanded in sync (hover + focus),
  // and let Escape close it. The reveal itself is CSS :hover / :focus-within.
  document.querySelectorAll<HTMLElement>('[data-services]').forEach((dd) => {
    const toggle = dd.querySelector('.nav-services-toggle');
    const sync = (open: boolean) => toggle?.setAttribute('aria-expanded', String(open));
    dd.addEventListener('pointerenter', () => sync(true));
    dd.addEventListener('pointerleave', () => sync(false));
    dd.addEventListener('focusin', () => sync(true));
    dd.addEventListener('focusout', () => { if (!dd.matches(':focus-within')) sync(false); });
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { sync(false); (document.activeElement as HTMLElement)?.blur(); }
    });
  });
</script>
