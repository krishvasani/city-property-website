---
// Locality × type landing page ("Office Space for Rent in Thaltej, Ahmedabad").
// Rendered by src/pages/{buy,rent}/[combo].astro. Every matching listing is
// in the HTML — no client-side paging or hiding.
import Base from '../layouts/Base.astro';
import PropertyCard from './PropertyCard.astro';
import LeadForm from './LeadForm.astro';
import CallButton from './CallButton.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { contact } from '../lib/config';
import { landingContent, comboLabel, type PropertyCombo } from '../lib/landing';
import { TYPE_SLUG_LABEL, sideWord } from '../lib/landing-core';

interface Props { combo: PropertyCombo; combos: PropertyCombo[] }
const { combo, combos } = Astro.props;
const c = landingContent(combo, combos);
const [single, plural] = TYPE_SLUG_LABEL[combo.typeSlug];
const loc = combo.locality;
const forWord = `for ${sideWord(combo.side)}`;
const waMessage = `Hi City Property Services, I’m looking for ${plural} ${forWord.toLowerCase()} in ${loc.name}. Could you share current options?`;
const ogImg = combo.listings.find((p) => p.photos?.some((x) => x.url))?.photos?.find((x) => x.url)?.url;
---
<Base
  title={c.title}
  description={c.description}
  brandSuffix={false}
  active={combo.side}
  breadcrumbs={c.breadcrumbs}
  jsonLd={c.graph}
  ogImage={ogImg}
  ogImageAlt={`${c.h1} — City Property Services`}
>
  <main class="wrap-wide landing">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span>
      <a href={`/${combo.side}/`}>{combo.side === 'buy' ? 'Buy' : 'Rent'}</a><span class="sep">›</span>
      <a href={`/localities/${loc.slug}/`}>{loc.name}</a><span class="sep">›</span>
      <span style="color:var(--ink);">{single} {forWord}</span>
    </nav>

    <section class="page-hero">
      <div class="eyebrow">{loc.region}{loc.microMarket ? ` · ${loc.microMarket}` : ''}</div>
      <h1 class="display" style="max-width:22ch;margin-top:12px;">{c.h1}</h1>
      {c.intro.map((p) => <p class="body-lg muted" style="max-width:70ch;margin-top:16px;">{p}</p>)}
    </section>

    <section class="summary">
      <h2 class="sr-only">Summary</h2>
      <table class="sum-table">
        <tbody>
          <tr><th scope="row">Listings</th><td>{c.stats.count} {c.stats.count === 1 ? single.toLowerCase() : plural} {forWord.toLowerCase()}</td></tr>
          <tr><th scope="row">Price range</th><td>{c.stats.priceRange ?? 'On request'}{c.stats.priceRange && c.stats.priced < c.stats.count ? ` (${c.stats.count - c.stats.priced} on request)` : ''}</td></tr>
          <tr><th scope="row">Size range</th><td>{c.stats.sizeRange ?? '—'}</td></tr>
          <tr><th scope="row">Typical price</th><td>{c.stats.typicalUnitPrice ?? '—'}</td></tr>
        </tbody>
      </table>
    </section>

    <section class="listings">
      <div class="between" style="margin-bottom:20px;">
        <h2>All {c.stats.count} {plural} {forWord.toLowerCase()} in {loc.name}</h2>
        <a class="btn btn-secondary btn-sm" href={`/${combo.side}/?locality=${loc.id}`}>Filter on the {combo.side} page →</a>
      </div>
      <div class="cards">
        {combo.listings.map((p) => <PropertyCard property={p} />)}
      </div>
    </section>

    {(c.otherTypesHere.length > 0 || c.siblingsSameType.length > 0) && (
      <section class="siblings">
        {c.otherTypesHere.length > 0 && (
          <div>
            <h2>Other property in {loc.name}</h2>
            <ul class="link-list">
              {c.otherTypesHere.map((o) => (
                <li><a href={o.path}>{comboLabel(o)}</a> <span class="muted">({o.listings.length})</span></li>
              ))}
              <li><a href={`/localities/${loc.slug}/`}>All property in {loc.name}</a></li>
            </ul>
          </div>
        )}
        {c.siblingsSameType.length > 0 && (
          <div>
            <h2>{single} {forWord} nearby</h2>
            <ul class="link-list">
              {c.siblingsSameType.map((o) => (
                <li><a href={o.path}>{comboLabel(o)}</a> <span class="muted">({o.listings.length})</span></li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <section class="faq">
      <h2>Questions about {plural} {forWord.toLowerCase()} in {loc.name}</h2>
      <dl class="faq-list">
        {c.faq.map((f) => (
          <div class="faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="lead">
      <div class="lead-grid">
        <div>
          <h2>Tell us what you need in {loc.name}</h2>
          <p class="muted" style="margin-top:10px;max-width:52ch;">Share your requirement and our team will send matching {plural}, including options that are not listed online yet.</p>
          <div class="row" style="gap:10px;margin-top:18px;flex-wrap:wrap;">
            <CallButton label="Call Now" number={contact.phone} />
            <WhatsAppButton label="WhatsApp Us" message={waMessage} />
          </div>
        </div>
        <div class="panel">
          <LeadForm
            name="viewing"
            submitLabel="Send my requirement"
            messageLabel="Requirement"
            messagePlaceholder={`e.g. ${plural} in ${loc.name}, size, budget and timeline…`}
            context={{ landing: c.h1, landingUrl: `${Astro.site ?? 'https://cityprop.co.in'}${combo.path.slice(1)}` }}
            whatsappFallback={waMessage}
          />
        </div>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  .landing .crumb { display: flex; align-items: center; gap: 8px; padding: 22px 0 6px; font-size: 13.5px; color: var(--text-muted); flex-wrap: wrap; }
  .landing .crumb a:hover { color: var(--navy); }
  .landing .crumb .sep { color: var(--text-faint); }
  .landing .summary { margin-top: 28px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sum-table { border-collapse: collapse; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); width: 100%; max-width: 720px; }
  .sum-table th, .sum-table td { text-align: left; padding: 12px 18px; border-bottom: 1px solid var(--hairline); font-size: 14.5px; vertical-align: top; }
  .sum-table tr:last-child th, .sum-table tr:last-child td { border-bottom: 0; }
  .sum-table th { color: var(--text-muted); font-weight: 600; width: 160px; white-space: nowrap; }
  .sum-table td { color: var(--ink); font-weight: 600; }
  .landing .listings { margin-top: 48px; }
  .landing .listings h2 { font-size: clamp(22px, 2.2vw, 28px); }
  .landing .siblings { margin-top: 56px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .landing .siblings h2 { font-size: 20px; margin-bottom: 12px; }
  .link-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .link-list a { color: var(--navy); font-weight: 600; }
  .link-list a:hover { text-decoration: underline; }
  .landing .faq { margin-top: 56px; max-width: 820px; }
  .landing .faq h2 { font-size: 22px; margin-bottom: 16px; }
  .faq-list { margin: 0; }
  .faq-item { padding: 16px 0; border-top: 1px solid var(--hairline); }
  .faq-item dt { font-weight: 650; color: var(--ink); font-size: 16px; }
  .faq-item dd { margin: 8px 0 0; color: var(--text); line-height: 1.6; }
  .landing .lead { margin: 64px 0 72px; }
  .lead-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
  .lead-grid .panel { background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); box-shadow: var(--shadow); padding: 22px; }
  @media (max-width: 900px) { .landing .siblings, .lead-grid { grid-template-columns: 1fr; } .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .cards { grid-template-columns: 1fr; } }
</style>
