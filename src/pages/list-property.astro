---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import Stat from '../components/Stat.astro';
---
<Base title="Get a free valuation" description="List your property with City Property Services — free valuation, professional photos, and access to verified buyers across Ahmedabad.">
  <main class="wrap">
    <section class="page-hero">
      <div class="eyebrow">Sell or lease with us</div>
      <h1 class="display" style="max-width:16ch;margin-top:12px;">Get a free valuation.</h1>
      <p class="body-lg muted" style="max-width:56ch;margin-top:18px;">Reach serious, verified buyers and tenants across Ahmedabad. We handle the valuation, professional photography, listing and viewings — you stay in control.</p>
      <div class="vstats">
        <Stat display="3,000+" label="Properties listed" />
        <Stat display="2,400+" label="Deals closed" />
        <Stat display="4.9★" label="Client rating" />
      </div>
    </section>

    <div class="vgrid">
      <div class="panel">
        <h3 style="margin-bottom:16px;">Request your free valuation</h3>
        <LeadForm
          name="valuation"
          submitLabel="Request free valuation"
          twoCol
          intentOptions={['Sell my property', 'Lease / rent out', 'Just exploring value']}
          context={{ source: 'list-property' }}
          messageLabel="Property details"
          messagePlaceholder="Locality, property type, size, and anything else we should know…"
          whatsappFallback="Hi, I’d like a free valuation for my property in Ahmedabad."
        />
      </div>
      <ul class="benefits">
        <li><b>Free, no-obligation valuation</b><span class="muted">A grounded price based on real local deals.</span></li>
        <li><b>Professional photos & listing</b><span class="muted">Your property shown at its best, everywhere buyers look.</span></li>
        <li><b>Verified buyers only</b><span class="muted">We pre-qualify enquiries so you meet serious people.</span></li>
        <li><b>End-to-end support</b><span class="muted">Paperwork, RERA, negotiations — handled.</span></li>
      </ul>
    </div>
  </main>
</Base>

<style is:global>
  .page-hero { padding: 64px 0 8px; text-align: left; }
  .vstats { display: flex; gap: 48px; margin-top: 32px; flex-wrap: wrap; }
  .vgrid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: start; padding: 32px 0 96px; }
  .panel { background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); padding: 28px; }
  .benefits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .benefits li { display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; border: 1px solid var(--hairline); border-radius: var(--r); background: var(--surface); box-shadow: var(--shadow-xs); }
  .benefits b { color: var(--ink); }
  @media (max-width: 860px) { .vgrid { grid-template-columns: 1fr; } }
</style>
