---
// /localities/{slug}/ — locality authority page: data-driven intro, market
// summary, every listing grouped by type, links to the locality's landing
// pages, FAQ. Content rules in src/lib/locality-content.ts.
import Base from '../../layouts/Base.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import Icon from '../../components/Icon.astro';
import LeadForm from '../../components/LeadForm.astro';
import CallButton from '../../components/CallButton.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getLocalitiesEverListed, getProperties } from '../../lib/data';
import { getAllLocalities, getLocalityById, propertyTextMatchesLocality } from '../../data/localities';
import { contact } from '../../lib/config';
import { landingCombos, comboLabel } from '../../lib/landing';
import { localityContent } from '../../lib/locality-content';
import { typeSlugOf, sideOf, TYPE_SLUG_LABEL } from '../../lib/landing-core';
import { SHANTIGRAM_LIVE } from '../../lib/flags';
import { projects as shantigramProjects } from '../../lib/projects';

// Generate pages for prime localities (priority 1–2) and any locality that has
// live listings, so pages are useful (never thin) and property breadcrumbs resolve.
export async function getStaticPaths() {
  const localities = getAllLocalities();
  // Includes localities whose listings were archived in Phase 1 — their guide
  // pages are the redirect targets for those listings, so they must keep building.
  const everListed = await getLocalitiesEverListed();
  return localities
    .filter((l) => l.priority <= 2 || everListed.has(l.id))
    .map((l) => ({ params: { slug: l.slug }, props: { localityId: l.id } }));
}

interface Props { localityId: string }
const { localityId } = Astro.props;
const loc = getLocalityById(localityId)!;

const all = await getProperties();
// Match by administrative slug OR by address/title text, so a road/sub-locality
// (e.g. Sindhu Bhavan Road) surfaces listings tagged with their parent area.
const listings = all.filter(
  (p) =>
    p.localitySlug === loc.id ||
    propertyTextMatchesLocality([p.title, p.localityName, p.address].filter(Boolean).join(' '), loc),
);
const combos = landingCombos(all);
// Which nearby areas have their own page (so we only link to real pages).
const pageIds = new Set(
  getAllLocalities().filter((l) => l.priority <= 2 || all.some((p) => p.localitySlug === l.id)).map((l) => l.id),
);
const c = localityContent(loc, listings, combos, all, pageIds);

// Every listing, grouped by property type (landing-page slug order), with a
// link to the matching /buy|rent/{type}-in-{locality}/ page where one exists.
const groupOrder = ['office-space', 'showroom', 'shop', 'warehouse', 'industrial-shed', 'flat', 'bungalow', 'plot', 'land', 'other'];
const groups = groupOrder
  .map((slug) => {
    const items = listings.filter((p) => (typeSlugOf(p.propertyType) ?? 'other') === slug);
    const label = slug === 'other' ? 'Other property' : TYPE_SLUG_LABEL[slug][1].replace(/^./, (ch) => ch.toUpperCase());
    const pages = c.landings.filter((x) => x.typeSlug === slug && items.some((p) => sideOf(p.status) === x.side));
    return { slug, label, items, pages };
  })
  .filter((g) => g.items.length);

const ogImg = listings.find((p) => p.photos?.some((x) => x.url))?.photos?.find((x) => x.url)?.url;
const waMessage = `Hi City Property Services, I’m looking for property in ${loc.name}. Could you share current options?`;
---
<Base
  title={c.title}
  description={c.description}
  brandSuffix={false}
  breadcrumbs={c.breadcrumbs}
  jsonLd={c.graph}
  ogImage={ogImg}
  ogImageAlt={`${c.h1} — City Property Services`}
  active="buy"
>
  <main class="wrap-wide loc-page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span>/</span> <a href="/localities/">Localities</a> <span>/</span>
      <span style="color:var(--ink);">{loc.name}</span>
    </nav>

    <section class="page-hero">
      <div class="eyebrow">{loc.region}{loc.microMarket ? ` · ${loc.microMarket}` : ''}</div>
      <h1 class="display" style="max-width:22ch;margin-top:12px;">{c.h1}</h1>
      {c.intro.map((p) => <p class="body-lg muted" style="max-width:70ch;margin-top:16px;">{p}</p>)}
      <div class="loc-actions">
        {c.hasSale && <a class="btn btn-primary" href={`/buy/?locality=${loc.id}`}>Buy in {loc.name}</a>}
        {c.hasRent && <a class="btn btn-secondary" href={`/rent/?locality=${loc.id}`}>Rent in {loc.name}</a>}
        <a class="btn btn-secondary" href={`/map/?locality=${loc.id}`}>View on map</a>
        <a class="btn btn-secondary" href="/consult/">Talk to an advisor</a>
      </div>
    </section>

    {SHANTIGRAM_LIVE && loc.id === 'shantigram' && (
      <section class="loc-township">
        <a class="loc-township-card" href="/projects/adani-shantigram/">
          <span class="lt-eyebrow">Township guide</span>
          <span class="lt-title">Adani Shantigram: all {shantigramProjects.length} current projects compared</span>
          <span class="lt-text">Configurations, sizes, developer prices as of July 2026, possession and RERA numbers for every project in the township, plus township amenities and distances. This page covers City Property Services' live listings and the resale market in the locality. →</span>
        </a>
      </section>
    )}

    {c.landings.length > 0 && (
      <section class="loc-landings">
        <h2>Browse {loc.name} by property type</h2>
        <ul class="landing-grid">
          {c.landings.map((x) => (
            <li>
              <a href={x.path}>
                <span class="lg-title">{comboLabel(x)}</span>
                <span class="lg-meta">{x.listings.length} {x.listings.length === 1 ? 'listing' : 'listings'} →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {c.rows.length > 0 && (
      <section class="market">
        <h2>{loc.name} market summary</h2>
        <div class="table-wrap">
          <table class="market-table">
            <thead>
              <tr><th scope="col">Property type</th><th scope="col">Listings</th><th scope="col">Price range</th><th scope="col">Size range</th><th scope="col">Typical price</th></tr>
            </thead>
            <tbody>
              {c.rows.map((r) => (
                <tr>
                  <th scope="row">{r.landing ? <a href={r.landing.path}>{r.label}</a> : r.label}</th>
                  <td>{r.stats.count}</td>
                  <td>{r.stats.priceRange ?? 'On request'}{r.stats.priceRange && r.stats.priced < r.stats.count ? ` (${r.stats.count - r.stats.priced} on request)` : ''}</td>
                  <td>{r.stats.sizeRange ?? '—'}</td>
                  <td>{r.stats.typicalUnitPrice ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {listings.length > 0 ? (
      <section class="section">
        <h2>Properties in {loc.name}</h2>
        <p class="muted" style="margin-bottom:8px;">{listings.length} live {listings.length === 1 ? 'listing' : 'listings'} in {loc.name}, grouped by type.</p>
        {groups.length > 1 && (
          <p class="loc-groups-nav muted">
            {groups.map((g, i) => <>{i > 0 && ' · '}<a href={`#${g.slug}`}>{g.label} ({g.items.length})</a></>)}
          </p>
        )}
        {groups.map((g) => (
          <div class="loc-group" id={g.slug}>
            <div class="between loc-group-head">
              <h3>{g.label} in {loc.name} <span class="muted">({g.items.length})</span></h3>
              {g.pages.length > 0 && (
                <div class="loc-group-links">
                  {g.pages.map((x) => <a class="btn btn-secondary btn-sm" href={x.path}>{comboLabel(x)} →</a>)}
                </div>
              )}
            </div>
            <div class="cards">
              {g.items.map((p) => <PropertyCard property={p} />)}
            </div>
          </div>
        ))}
      </section>
    ) : (
      <section class="section">
        <div class="band between" style="align-items:center;">
          <div>
            <h2 style="color:#fff;">Looking for property in {loc.name}?</h2>
            <p style="color:#c4d0d8;max-width:52ch;margin-top:8px;">We have off‑market and upcoming options in {loc.name} that are not always listed online. Tell us what you need and we will share matches.</p>
          </div>
          <a class="btn btn-light" href="/consult/">Request options</a>
        </div>
      </section>
    )}

    <section class="section loc-facts">
      <div>
        <h2>{loc.name} at a glance</h2>
        <dl class="facts-list">
          {c.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </div>
      <div>
        {loc.popularFor?.length > 0 && (
          <>
            <h2>What {loc.name} is known for</h2>
            <div class="chips" style="margin-bottom:28px;">{loc.popularFor.map((p) => <span class="chip">{p}</span>)}</div>
          </>
        )}
        {loc.connectivity?.length > 0 && (
          <>
            <h2>Connectivity &amp; access</h2>
            <ul class="loc-list">{loc.connectivity.map((x) => <li><Icon name="pin" sw={1.8} />{x}</li>)}</ul>
          </>
        )}
      </div>
    </section>

    {c.nearbyCards.length > 0 && (
      <section class="section">
        <h2>Nearby areas</h2>
        <p class="muted" style="margin:6px 0 18px;max-width:64ch;">Neighbouring localities buyers and tenants in {loc.name} also consider.</p>
        <div class="nearby-grid">
          {c.nearbyCards.map((nb) => (
            <a class="nearby-card" href={nb.hasPage ? `/localities/${nb.loc.slug}/` : `/buy/?locality=${nb.loc.id}`}>
              <span class="nearby-name">{nb.loc.name}<span class="nearby-count">{nb.count ? `${nb.count} live` : nb.loc.region}</span></span>
              <span class="nearby-blurb">{nb.blurb}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="faq">
      <h2>Questions about property in {loc.name}</h2>
      <dl class="faq-list">
        {c.faq.map((f) => (
          <div class="faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>
        ))}
      </dl>
    </section>

    <section class="lead">
      <div class="lead-grid">
        <div>
          <h2>Buy, sell, rent or invest in {loc.name}</h2>
          <p class="muted" style="margin-top:10px;max-width:52ch;">Talk to a local advisor who knows {loc.name} street by street, for honest guidance on price, locality and timing.</p>
          <div class="row" style="gap:10px;margin-top:18px;flex-wrap:wrap;">
            <CallButton label="Call Now" number={contact.phone} />
            <WhatsAppButton label="WhatsApp Us" message={waMessage} />
          </div>
        </div>
        <div class="panel">
          <LeadForm
            name="viewing"
            submitLabel="Send my requirement"
            messageLabel="Requirement"
            messagePlaceholder={`e.g. what you need in ${loc.name}, size, budget and timeline…`}
            context={{ locality: loc.name, localityUrl: `${Astro.site ?? 'https://cityprop.co.in'}localities/${loc.slug}/` }}
            whatsappFallback={waMessage}
          />
        </div>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  .loc-page .crumb { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--text-muted); padding: 20px 0 0; }
  .loc-page .crumb a:hover { color: var(--navy); }
  .loc-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .loc-township { margin-top: 32px; }
  .loc-township-card { display: flex; flex-direction: column; gap: 4px; padding: 18px 22px; background: var(--navy); color: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow-sm); }
  .lt-eyebrow { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--sky); font-weight: 700; }
  .lt-title { font-size: 19px; font-weight: 700; }
  .lt-text { font-size: 14px; color: #c4d0d8; }
  .loc-landings { margin-top: 40px; }
  .loc-landings h2 { font-size: 22px; margin-bottom: 14px; }
  .landing-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .landing-grid a { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r); box-shadow: var(--shadow-xs); transition: border-color var(--t) var(--ease), box-shadow var(--t) var(--ease); }
  .landing-grid a:hover { border-color: var(--navy); box-shadow: var(--shadow-sm); }
  .landing-grid .lg-title { font-weight: 650; color: var(--ink); font-size: 15px; }
  .landing-grid .lg-meta { color: var(--navy); font-size: 13px; font-weight: 600; white-space: nowrap; }
  .market { margin-top: 48px; }
  .market h2 { font-size: 22px; margin-bottom: 14px; }
  .table-wrap { overflow-x: auto; }
  .market-table { border-collapse: collapse; width: 100%; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); font-size: 14.5px; }
  .market-table th, .market-table td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .market-table thead th { color: var(--text-muted); font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; background: var(--surface-2); }
  .market-table tbody th { font-weight: 650; color: var(--ink); white-space: nowrap; }
  .market-table tbody th a { color: var(--navy); }
  .market-table tbody tr:last-child th, .market-table tbody tr:last-child td { border-bottom: 0; }
  .loc-page .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .loc-page .chip { display: inline-flex; align-items: center; padding: 8px 14px; border: 1px solid var(--hairline); border-radius: var(--r-pill); font-size: 13.5px; font-weight: 600; color: var(--text); background: var(--surface); }
  .loc-page a.chip-link:hover { border-color: var(--navy); color: var(--navy); }
  .loc-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding-block: 48px; }
  .facts-list { margin: 0; display: grid; gap: 0; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--shadow-xs); overflow: hidden; }
  .facts-list > div { display: grid; grid-template-columns: 150px 1fr; gap: 12px; padding: 11px 16px; border-bottom: 1px solid var(--hairline); font-size: 14.5px; }
  .facts-list > div:last-child { border-bottom: 0; }
  .facts-list dt { color: var(--text-muted); font-weight: 600; }
  .facts-list dd { margin: 0; color: var(--ink); font-weight: 500; }
  .nearby-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .nearby-card { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; border: 1px solid var(--hairline); border-radius: var(--r); background: var(--surface); box-shadow: var(--shadow-xs); transition: border-color var(--t) var(--ease), box-shadow var(--t) var(--ease); }
  .nearby-card:hover { border-color: var(--navy); box-shadow: var(--shadow-sm); }
  .nearby-name { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-weight: 650; color: var(--ink); }
  .nearby-count { font-size: 11.5px; font-weight: 600; color: var(--navy); background: var(--navy-tint); border-radius: 999px; padding: 2px 8px; white-space: nowrap; }
  .nearby-blurb { font-size: 13.5px; color: var(--text-muted); line-height: 1.5; }
  .loc-facts h2 { font-size: 22px; margin-bottom: 14px; }
  .loc-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 12px; max-width: 760px; }
  .loc-list li { display: flex; align-items: center; gap: 10px; font-size: 15px; color: var(--text); }
  .loc-list svg { width: 16px; height: 16px; color: var(--sky); flex: none; }
  .loc-groups-nav { font-size: 14px; margin-bottom: 8px; }
  .loc-groups-nav a { color: var(--navy); font-weight: 600; }
  .loc-group { margin-top: 28px; scroll-margin-top: 90px; }
  .loc-group-head { align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  .loc-group-head h3 { font-size: 20px; }
  .loc-group-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .loc-page .faq { margin-top: 24px; max-width: 820px; }
  .loc-page .faq h2 { font-size: 22px; margin-bottom: 16px; }
  .faq-list { margin: 0; }
  .faq-item { padding: 16px 0; border-top: 1px solid var(--hairline); }
  .faq-item dt { font-weight: 650; color: var(--ink); font-size: 16px; }
  .faq-item dd { margin: 8px 0 0; color: var(--text); line-height: 1.6; }
  .loc-page .lead { margin: 64px 0 72px; }
  .lead-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
  .lead-grid .panel { background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); box-shadow: var(--shadow); padding: 22px; }
  @media (max-width: 900px) { .landing-grid, .nearby-grid { grid-template-columns: 1fr 1fr; } .loc-facts, .lead-grid { grid-template-columns: 1fr; } .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .landing-grid, .nearby-grid { grid-template-columns: 1fr; } .cards { grid-template-columns: 1fr; } .facts-list > div { grid-template-columns: 1fr; gap: 2px; } }
</style>
