---
// /projects/adani-shantigram/{project}/ — one page per project. Draft until
// SHANTIGRAM_LIVE is true. Content: src/lib/shantigram-content.ts.
import Base from '../../../layouts/Base.astro';
import Gallery from '../../../components/Gallery.astro';
import ProjectEnquiry from '../../../components/ProjectEnquiry.astro';
import { SHANTIGRAM_LIVE } from '../../../lib/flags';
import { projectContent, priceDisclaimer } from '../../../lib/shantigram-content';
import { projects, projectPath, HUB_PATH, type Project } from '../../../lib/projects';
import { site } from '../../../lib/config';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { project: p.slug }, props: { p } }));
}
interface Props { p: Project }
const { p } = Astro.props;
const c = projectContent(p);
const url = `${site.url}${projectPath(p)}`;
const galleryPhotos = p.photos.map((u, i) => ({ url: u, alt: `${p.name} — developer render ${i + 1}`, label: 'Developer render' }));
const cell = (cfg: any, key: string) => {
  const v = cfg[key];
  if (v === undefined || v === null) return '—';
  if (key === 'priceDisplay') return cfg.soldOut ? 'Sold out' : v;
  return typeof v === 'number' ? v.toLocaleString('en-IN') : v;
};
---
<Base
  title={c.title}
  description={c.description}
  brandSuffix={false}
  noindex={!SHANTIGRAM_LIVE}
  breadcrumbs={c.breadcrumbs}
  jsonLd={c.graph}
  ogImage={p.photos[0]}
  ogImageAlt={`${p.name}, Adani Shantigram — developer render`}
  active="buy"
>
  <main class="wrap-wide shg proj">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span>
      <a href={HUB_PATH}>Adani Shantigram</a><span class="sep">›</span>
      <span style="color:var(--ink);">{p.name}</span>
    </nav>

    {!SHANTIGRAM_LIVE && <p class="draft-banner">Draft — not indexed. Prices, RERA number and possession date await verification.</p>}

    <Gallery photos={galleryPhotos} totalCount={p.photos.length} />

    <section class="proj-head">
      <div class="eyebrow">{p.developer}{p.partner ? ` · with ${p.partner.replace(/ \(.*\)/, '')}` : ''} · Gujarat RERA {p.rera}</div>
      <h1 class="display" style="max-width:20ch;margin-top:10px;">{c.h1}</h1>
      {c.overview.map((para) => <p class="body-lg muted" style="max-width:72ch;margin-top:14px;">{para}</p>)}
      <p class="small muted" style="margin-top:14px;max-width:72ch;">{priceDisclaimer(p.priceAsOf)}</p>
    </section>

    <section class="proj-configs">
      <h2>Configurations and prices</h2>
      <div class="table-wrap">
        <table class="cmp-table">
          <thead><tr><th scope="col">Configuration</th>{c.configCols.map((col) => <th scope="col">{col.label}</th>)}</tr></thead>
          <tbody>
            {p.configurations.map((cfg) => (
              <tr><th scope="row">{cfg.label}</th>{c.configCols.map((col) => <td>{cell(cfg, col.key as string)}{col.key === 'priceDisplay' && cfg.priceNote ? <span class="muted small"> — {cfg.priceNote}</span> : null}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      {p.factSheetAreas && (
        <p class="small muted" style="margin-top:10px;max-width:72ch;">Fact-sheet areas, recorded separately because they do not reconcile with the brochure: {Object.entries(p.factSheetAreas).map(([k, v]) => `${k} ${v}`).join('; ')}.</p>
      )}
      {p.unpublishedPricing && (
        <p class="small muted" style="margin-top:10px;max-width:72ch;">Pricing for this project is on request. We hold the developer's current rate sheet and will walk you through the all-inclusive figure for the configuration you want.</p>
      )}
    </section>

    <section class="proj-specs">
      <h2>Specifications</h2>
      <dl class="facts-list">
        {c.specs.map((s) => <div><dt>{s.k}</dt><dd>{s.v}</dd></div>)}
      </dl>
    </section>

    <section class="proj-amen">
      <h2>Amenities at {p.name}</h2>
      <ul class="amen-list">{p.amenities.map((a) => <li>{a}</li>)}</ul>
      {p.proposedServices?.length && (
        <>
          <h3 style="margin-top:20px;">Proposed services</h3>
          <ul class="amen-list">{p.proposedServices.map((a) => <li>{a}</li>)}</ul>
        </>
      )}
    </section>

    {p.floorPlans.length > 0 && (
      <section class="proj-plans">
        <h2>Floor plans and layouts</h2>
        <p class="muted" style="margin:6px 0 14px;">Developer drawings from the project brochure. Areas on the drawings are indicative; the RERA carpet figures in the table above govern.</p>
        <div class="plan-grid">
          {p.floorPlans.map((u, i) => <a href={u} target="_blank" rel="noopener"><img src={u} alt={`${p.name} floor plan ${i + 1}`} loading="lazy" /></a>)}
        </div>
      </section>
    )}

    <section class="proj-where">
      <h2>Where {p.name} sits in the township</h2>
      <p style="max-width:72ch;line-height:1.65;">{p.locationInTownship ?? `The developer's documents place ${p.name} inside Adani Shantigram at Vaishnodevi Circle on the SG Highway, but do not describe its position within the township beyond that.`} Township-level facilities — the golf club, lake, schools, retail and the e-bus — are shared by every project; see the <a href={HUB_PATH}>Adani Shantigram township guide</a> for the full list and road distances.</p>
      {p.distancesFromZeroCircle && (
        <ul class="dist-list" style="margin-top:14px;">{p.distancesFromZeroCircle.map((d) => <li><span>{d.to}</span><b>{d.km} km</b></li>)}</ul>
      )}
    </section>

    <section class="proj-siblings">
      <h2>Other projects in Adani Shantigram</h2>
      {c.siblings.map((g) => (
        <div class="sib-group">
          <h3>{g.type}</h3>
          <ul class="sib-list">
            {g.items.map((s) => <li><a href={projectPath(s.p)}>{s.p.name}</a><span class="muted"> — {s.line}</span></li>)}
          </ul>
        </div>
      ))}
      <p style="margin-top:14px;"><a class="btn btn-secondary btn-sm" href={HUB_PATH}>Compare all {projects.length} projects →</a></p>
    </section>

    <section class="shg-faq">
      <h2>Questions about {p.name}</h2>
      <dl class="faq-list">
        {c.faq.map((f) => <div class="faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>)}
      </dl>
    </section>

    <ProjectEnquiry subject={p.name} url={url} />
  </main>
</Base>

<style is:global>
  .shg .crumb { display: flex; align-items: center; gap: 8px; padding: 22px 0 6px; font-size: 13.5px; color: var(--text-muted); flex-wrap: wrap; }
  .shg .crumb .sep { color: var(--text-faint); }
  .draft-banner { margin: 12px 0 0; padding: 10px 14px; border-radius: var(--r); background: #fff4d6; border: 1px solid #f0d48a; color: #6b4d00; font-size: 13.5px; font-weight: 600; }
  .table-wrap { overflow-x: auto; }
  .cmp-table { border-collapse: collapse; width: 100%; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); font-size: 14px; }
  .cmp-table th, .cmp-table td { text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .cmp-table thead th { background: var(--surface-2); color: var(--text-muted); font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; white-space: nowrap; }
  .cmp-table tbody th { font-weight: 700; color: var(--ink); white-space: nowrap; }
  .cmp-table tbody tr:last-child th, .cmp-table tbody tr:last-child td { border-bottom: 0; }
  .dist-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; max-width: 900px; }
  .dist-list li { display: flex; justify-content: space-between; gap: 10px; padding: 10px 14px; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r); font-size: 14px; }
  .shg-faq { margin-top: 56px; max-width: 860px; }
  .shg-faq h2 { margin-bottom: 16px; }
  .faq-list { margin: 0; }
  .faq-item { padding: 16px 0; border-top: 1px solid var(--hairline); }
  .faq-item dt { font-weight: 650; color: var(--ink); font-size: 16px; }
  .faq-item dd { margin: 8px 0 0; color: var(--text); line-height: 1.6; }
  .proj .gallery { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 10px; height: 460px; border-radius: var(--r-xl); overflow: hidden; margin-top: 16px; }
  .proj .gallery .g0 { grid-row: 1 / 3; }
  .proj .gallery .cell { position: relative; cursor: pointer; overflow: hidden; }
  .proj .gallery .more { position: absolute; right: 12px; bottom: 12px; }
  .proj-head { margin-top: 28px; }
  .proj-configs, .proj-specs, .proj-amen, .proj-plans, .proj-where, .proj-siblings { margin-top: 48px; }
  .proj h2 { font-size: clamp(22px, 2.4vw, 28px); margin-bottom: 14px; }
  .facts-list { margin: 0; display: grid; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--shadow-xs); overflow: hidden; max-width: 820px; }
  .facts-list > div { display: grid; grid-template-columns: 170px 1fr; gap: 12px; padding: 11px 16px; border-bottom: 1px solid var(--hairline); font-size: 14.5px; }
  .facts-list > div:last-child { border-bottom: 0; }
  .facts-list dt { color: var(--text-muted); font-weight: 600; }
  .facts-list dd { margin: 0; color: var(--ink); font-weight: 500; }
  .amen-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px 20px; max-width: 980px; }
  .amen-list li { padding: 8px 12px; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r); font-size: 14px; }
  .plan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .plan-grid img { width: 100%; border: 1px solid var(--hairline); border-radius: var(--r); background: #fff; display: block; }
  .sib-group { margin-top: 14px; }
  .sib-group h3 { font-size: 16px; margin-bottom: 6px; }
  .sib-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 14.5px; }
  .sib-list a { color: var(--navy); font-weight: 650; }
  @media (max-width: 1000px) { .proj .gallery { grid-template-columns: 1fr 1fr; grid-template-rows: 220px 140px; height: auto; } .proj .gallery .g0 { grid-row: auto; grid-column: 1 / 3; } .amen-list, .plan-grid { grid-template-columns: 1fr 1fr; } .dist-list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .amen-list, .plan-grid { grid-template-columns: 1fr; } .facts-list > div { grid-template-columns: 1fr; gap: 2px; } }
</style>
