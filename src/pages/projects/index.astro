---
// /projects/ — the index of every new commercial project we advise on, and the
// entry point to the Adani Shantigram township guide. Draft until
// COMMERCIAL_PROJECTS_LIVE is true. Copy: src/lib/commercial-content.ts.
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import CallButton from '../../components/CallButton.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { COMMERCIAL_PROJECTS_LIVE, SHANTIGRAM_LIVE } from '../../lib/flags';
import { indexContent } from '../../lib/commercial-content';
import {
  commercialProjects, commercialPath, isReady, possessionLabel, rateLine,
  sizeRange, useSummary,
} from '../../lib/commercial-projects';
import { projects as shantigramProjects, HUB_PATH } from '../../lib/projects';
import { contact, site } from '../../lib/config';

const c = indexContent();
const all = commercialProjects;
const areas = [...new Set(all.map((p) => p.localityName))].sort();
const wa = 'Hi City Property Services, I’d like to know about new commercial projects in Ahmedabad.';
---
<Base
  title={c.title}
  description={c.description}
  noindex={!COMMERCIAL_PROJECTS_LIVE}
  breadcrumbs={[{ name: 'Home', url: `${site.url}/` }, { name: 'Projects', url: `${site.url}/projects/` }]}
  jsonLd={c.graph}
  active="buy"
>
  <main class="wrap-wide cpi">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span>
      <span style="color:var(--ink);">Projects</span>
    </nav>

    {!COMMERCIAL_PROJECTS_LIVE && <p class="draft-banner">Draft — not indexed. Photographs are pending and every rate, RERA number and possession date awaits verification.</p>}

    <section class="page-hero">
      <div class="eyebrow">New projects · Ahmedabad</div>
      <h1 class="display" style="max-width:17ch;margin-top:12px;">{c.h1}</h1>
      {c.intro.map((p) => <p class="body-lg muted" style="max-width:74ch;margin-top:16px;">{p}</p>)}
    </section>

    <section class="cpi-sec">
      <h2>All {all.length} projects at a glance</h2>
      <p class="cpi-sub">Sorted with ready buildings first, then by possession date. Carpet area is the range across the whole building; rates are per sq ft as quoted by each developer's sales team on 24 September 2026.</p>
      <div class="table-wrap">
        <table class="cmp-table">
          <thead>
            <tr>
              <th scope="col">Project</th><th scope="col">Area</th><th scope="col">Use</th>
              <th scope="col">Floors</th><th scope="col">Carpet area</th><th scope="col">Rates</th><th scope="col">Possession</th>
            </tr>
          </thead>
          <tbody>
            {all.map((p) => (
              <tr>
                <th scope="row"><a href={commercialPath(p)}>{p.name}</a><span class="muted small"> · {p.developer}</span></th>
                <td>{p.localityName}</td>
                <td>{useSummary(p)}</td>
                <td>{p.floors}</td>
                <td>{sizeRange(p) ?? '—'}</td>
                <td>{rateLine(p)}</td>
                <td><span class:list={['status', { ready: isReady(p) }]}>{possessionLabel(p)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="cpi-sec">
      <h2>The projects</h2>
      <ul class="proj-grid">
        {all.map((p) => (
          <li>
            <a class="proj-card" href={commercialPath(p)}>
              {p.photos[0] ? <img src={p.photos[0]} alt={`${p.name}, ${p.localityName}`} loading="lazy" /> : <div class="ph" data-label="Photographs pending"></div>}
              <span class="proj-card-body">
                <span class="proj-card-name">{p.name}</span>
                <span class="proj-card-meta">{useSummary(p)} · {p.localityName}</span>
                <span class="proj-card-meta muted">{p.floors} · {possessionLabel(p)}</span>
                <span class="proj-card-rate">{rateLine(p)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="cpi-sec">
      <h2>By area</h2>
      <ul class="area-list">
        {areas.map((a) => {
          const inArea = all.filter((p) => p.localityName === a);
          return (
            <li>
              <b>{a}</b>
              <span class="muted"> — {inArea.map((p) => p.name).join(', ')}</span>
            </li>
          );
        })}
      </ul>
    </section>

    {SHANTIGRAM_LIVE && (
      <section class="cpi-sec cpi-cross">
        <div class="eyebrow">Residential</div>
        <h2>Adani Shantigram</h2>
        <p class="muted" style="max-width:72ch;margin-top:8px;">Looking for a home rather than an office? The Adani Shantigram township on the SG Highway has {shantigramProjects.length} residential projects currently selling — apartments, villas and plots — compared on configuration, size, price and possession.</p>
        <p style="margin-top:14px;"><a class="btn btn-secondary btn-sm" href={HUB_PATH}>Adani Shantigram township guide →</a></p>
      </section>
    )}

    <section class="cpi-sec cpi-faq">
      <h2>How commercial pricing works in Ahmedabad</h2>
      <dl class="faq-list">
        {c.faq.map((f) => <div class="faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>)}
      </dl>
    </section>

    <section class="proj-enquiry" id="enquire">
      <div class="proj-enquiry-copy">
        <div class="eyebrow">Independent advice</div>
        <h2>Tell us what you need</h2>
        <p class="muted">Give us the carpet area you want, the budget and the area, and we will come back with the buildings that fit and what is actually unsold in them. City Property Services is an independent property consultant registered with Gujarat RERA (<strong>{site.rera}</strong>). We are not the developer of any project listed here.</p>
        <div class="row" style="gap:10px;margin-top:18px;flex-wrap:wrap;">
          <CallButton label="Call Now" number={contact.phone} />
          <WhatsAppButton label="WhatsApp Us" message={wa} />
        </div>
      </div>
      <div class="panel">
        <LeadForm
          name="viewing"
          submitLabel="Send my requirement"
          messageLabel="What are you looking for?"
          messagePlaceholder="e.g. 1,500 sq ft carpet office on SG Highway, ready or possession within a year…"
          context={{ project: 'Commercial projects index', projectUrl: `${site.url}/projects/` }}
          whatsappFallback={wa}
        />
      </div>
    </section>
  </main>
</Base>

<style is:global>
  .cpi .crumb { display: flex; align-items: center; gap: 8px; padding: 22px 0 6px; font-size: 13.5px; color: var(--text-muted); flex-wrap: wrap; }
  .cpi .crumb .sep { color: var(--text-faint); }
  .cpi .draft-banner { margin: 12px 0 0; padding: 10px 14px; border-radius: var(--r); background: #fff4d6; border: 1px solid #f0d48a; color: #6b4d00; font-size: 13.5px; font-weight: 600; }
  .cpi-sec { margin-top: 56px; }
  .cpi h2 { font-size: clamp(22px, 2.4vw, 28px); margin-bottom: 8px; }
  .cpi-sub { color: var(--text-muted); margin: 0 0 16px; max-width: 76ch; line-height: 1.6; font-size: 14.5px; }

  .cpi .table-wrap { overflow-x: auto; }
  .cpi .cmp-table { border-collapse: collapse; width: 100%; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); font-size: 14px; }
  .cpi .cmp-table th, .cpi .cmp-table td { text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .cpi .cmp-table thead th { background: var(--surface-2); color: var(--text-muted); font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; white-space: nowrap; }
  .cpi .cmp-table tbody th { font-weight: 700; color: var(--ink); }
  .cpi .cmp-table tbody th a { color: var(--navy); }
  .cpi .cmp-table tbody tr:last-child th, .cpi .cmp-table tbody tr:last-child td { border-bottom: 0; }
  .cpi .status { display: inline-block; padding: 3px 9px; border-radius: 999px; background: var(--surface-2); font-size: 12.5px; font-weight: 600; color: var(--text); white-space: nowrap; }
  .cpi .status.ready { background: var(--good-tint); color: var(--good); }

  .cpi .proj-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .cpi .proj-card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-xs); transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease); }
  .cpi .proj-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .cpi .proj-card img, .cpi .proj-card .ph { aspect-ratio: 16 / 10; width: 100%; object-fit: cover; object-position: center 30%; display: block; }
  .cpi .proj-card-body { display: flex; flex-direction: column; gap: 3px; padding: 12px 14px 14px; }
  .cpi .proj-card-name { font-weight: 700; color: var(--ink); font-size: 16px; }
  .cpi .proj-card-meta { font-size: 13.5px; color: var(--text); }
  .cpi .proj-card-rate { font-size: 13.5px; color: var(--navy); font-weight: 600; margin-top: 4px; }

  .cpi .area-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 980px; }
  .cpi .area-list li { padding: 12px 16px; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r); font-size: 14.5px; line-height: 1.5; }

  .cpi-cross { padding: 24px 26px; background: var(--surface-2); border-radius: var(--r-lg); }
  .cpi-cross h2 { margin-top: 6px; }
  .cpi-faq { max-width: 860px; }
  .cpi .faq-list { margin: 0; }
  .cpi .faq-item { padding: 16px 0; border-top: 1px solid var(--hairline); }
  .cpi .faq-item dt { font-weight: 650; color: var(--ink); font-size: 16px; }
  .cpi .faq-item dd { margin: 8px 0 0; color: var(--text); line-height: 1.6; }

  @media (max-width: 1000px) { .cpi .proj-grid { grid-template-columns: repeat(2, 1fr); } .cpi .area-list { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .cpi .proj-grid { grid-template-columns: 1fr; } }
</style>
