---
// /projects/{slug}/ — one page per commercial building. Every project uses this
// one template, so they all read the same way. Draft until COMMERCIAL_PROJECTS_LIVE
// is true. Data: src/content/projects/commercial/*.json. Copy: src/lib/commercial-content.ts.
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import ProjectEnquiry from '../../components/ProjectEnquiry.astro';
import { COMMERCIAL_PROJECTS_LIVE } from '../../lib/flags';
import { projectContent, rateDisclaimer } from '../../lib/commercial-content';
import {
  allProjects, commercialPath, PROJECTS_INDEX, isReady, possessionLabel,
  rate, rateLine, sections, useSummary, type CommercialProject,
} from '../../lib/commercial-projects';
import { site } from '../../lib/config';

export function getStaticPaths() {
  return allProjects.map((p) => ({ params: { project: p.slug }, props: { p } }));
}
interface Props { p: CommercialProject }
const { p } = Astro.props;
const c = projectContent(p);
const url = `${site.url}${commercialPath(p)}`;
const nav = sections(p);
const ready = isReady(p);

const galleryPhotos = p.photos.map((u, i) => ({
  url: u,
  alt: `${p.name}, ${p.localityName} — ${p.photoLabels?.[i] || 'developer image'}`,
  label: p.photoLabels?.[i] || 'Developer image',
}));

// Rate tables. Both plans are shown only when the developer quotes both.
const offRegular = p.pricing.office.some((o) => o.regular);
const offDp = p.pricing.office.some((o) => o.dp);
const retRegular = p.pricing.retailByFloor.some((r) => r.regular);
const retDp = p.pricing.retailByFloor.some((r) => r.dp);
const hasRates = p.pricing.office.length > 0 || p.pricing.retailByFloor.length > 0;

// Siblings come from the same category, so an office page does not suggest flats.
const others = allProjects.filter((o) => o.slug !== p.slug && o.category === p.category);
const nearby = others.filter((o) => o.localitySlug === p.localitySlug);
const rest = others.filter((o) => o.localitySlug !== p.localitySlug);
const siblings = [...nearby, ...rest].slice(0, 4);
---
<Base
  title={c.title}
  description={c.description}
  brandSuffix={false}
  noindex={!COMMERCIAL_PROJECTS_LIVE}
  breadcrumbs={c.breadcrumbs}
  jsonLd={c.graph}
  ogImage={p.photos[0]}
  ogImageAlt={`${p.name}, ${p.localityName}, Ahmedabad`}
  active="buy"
>
  <main class="wrap-wide cp">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span>
      <a href={PROJECTS_INDEX}>Projects</a><span class="sep">›</span>
      <span style="color:var(--ink);">{p.name}</span>
    </nav>

    {!COMMERCIAL_PROJECTS_LIVE && <p class="draft-banner">Draft — not indexed. Photographs are pending and every rate, RERA number and possession date awaits verification.</p>}

    <Gallery photos={galleryPhotos} totalCount={p.photos.length} />

    <header class="cp-head" id="overview">
      <div class="eyebrow">{c.eyebrow}</div>
      <h1 class="display">{c.h1}</h1>
      <ul class="cp-facts">
        {c.facts.map((f) => <li><span>{f.k}</span><b>{f.v}</b></li>)}
      </ul>
      <p class="cp-rate">{rateLine(p)}</p>
    </header>

    <nav class="cp-nav" aria-label="On this page">
      <ul>{nav.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ul>
    </nav>

    <section class="cp-sec">
      <h2>About {p.name}</h2>
      {c.overview.map((para) => <p class="cp-para">{para}</p>)}
    </section>

    {p.category === 'residential' && (
      <section class="cp-sec" id="homes">
        <h2>Homes and price</h2>
        <dl class="facts-list">
          <div><dt>Configurations</dt><dd>{p.configurations}</dd></div>
          <div><dt>Price</dt><dd>{rateLine(p)}</dd></div>
          <div><dt>Status</dt><dd>{p.status}</dd></div>
          <div><dt>Possession</dt><dd>{possessionLabel(p)}</dd></div>
        </dl>
        <p class="cp-note">Price as recorded in the City Property Services project master on 24 September 2026. Carpet and super built-up areas for this project are not yet on file — ask us and we will get them from the developer with the current price.</p>
      </section>
    )}

    {p.floorMix.length > 0 && (
      <section class="cp-sec" id="floors">
        <h2>Floor by floor</h2>
        <p class="cp-sub">What sits on each level, with the carpet area and the super built-up area against it. Rates in Ahmedabad are usually quoted against super built-up, so check the basis of any quote before comparing two buildings.</p>
        <div class="table-wrap">
          <table class="cmp-table">
            <thead>
              <tr>
                <th scope="col">Floor</th><th scope="col">Use</th><th scope="col">Units</th>
                <th scope="col">Carpet area</th><th scope="col">Super built-up</th><th scope="col">Ceiling</th>
              </tr>
            </thead>
            <tbody>
              {p.floorMix.map((f) => (
                <tr>
                  <th scope="row">{f.floor}</th>
                  <td>{f.use ?? '—'}</td>
                  <td>{f.unitsPerFloor ?? '—'}</td>
                  <td>{f.carpet ?? '—'}</td>
                  <td>{f.sbu ?? '—'}</td>
                  <td>{f.ceiling ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {(hasRates || p.pricing.extraCharges) && (
      <section class="cp-sec" id="pricing">
        <h2>Rates and charges</h2>
        <p class="cp-sub">All figures are per sq ft unless stated. The regular plan is paid against construction milestones; the down-payment plan is paid up front and is priced lower.</p>

        {p.pricing.office.length > 0 && (
          <div class="cp-rates">
            <h3>Offices</h3>
            <div class="table-wrap">
              <table class="cmp-table">
                <thead><tr><th scope="col">Unit type</th>{offRegular && <th scope="col">Regular plan</th>}{offDp && <th scope="col">Down-payment plan</th>}</tr></thead>
                <tbody>
                  {p.pricing.office.map((o) => (
                    <tr>
                      <th scope="row">{o.label}</th>
                      {offRegular && <td>{o.regular ? rate(o.regular) : '—'}</td>}
                      {offDp && <td>{o.dp ? rate(o.dp) : '—'}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {p.pricing.retailByFloor.length > 0 && (
          <div class="cp-rates">
            <h3>Retail</h3>
            <div class="table-wrap">
              <table class="cmp-table">
                <thead><tr><th scope="col">Floor</th>{retRegular && <th scope="col">Regular plan</th>}{retDp && <th scope="col">Down-payment plan</th>}</tr></thead>
                <tbody>
                  {p.pricing.retailByFloor.map((r) => (
                    <tr>
                      <th scope="row">{r.floor === 'G' ? 'Ground' : r.floor}</th>
                      {retRegular && <td>{r.regular ? rate(r.regular) : '—'}</td>}
                      {retDp && <td>{r.dp ? rate(r.dp) : '—'}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {p.pricing.retailDpNote && <p class="cp-note">{p.pricing.retailDpNote}</p>}
          </div>
        )}

        {(p.pricing.extraCharges || p.pricing.floorRise) && (
          <dl class="facts-list" style="margin-top:20px;">
            {p.pricing.extraCharges && <div><dt>On top of the basic rate</dt><dd>{p.pricing.extraCharges}</dd></div>}
            {p.pricing.floorRise && <div><dt>Floor rise</dt><dd>{p.pricing.floorRise}</dd></div>}
          </dl>
        )}

        <p class="cp-note">{rateDisclaimer(p.priceAsOf)}</p>
        <p class="cp-note">Source: {p.priceSource}.</p>
      </section>
    )}

    <section class="cp-sec" id="specs">
      <h2>Specifications</h2>
      <dl class="facts-list">
        {c.specs.map((s) => <div><dt>{s.k}</dt><dd>{s.v}</dd></div>)}
      </dl>
      {p.reraNote && <p class="cp-note">{p.reraNote}</p>}
    </section>

    {p.amenities.length > 0 && (
      <section class="cp-sec" id="amenities">
        <h2>Amenities</h2>
        <p class="cp-sub">As specified by the developer for {p.name}.</p>
        <ul class="amen-list">{p.amenities.map((a) => <li>{a}</li>)}</ul>
      </section>
    )}

    <section class="cp-sec" id="location">
      <h2>Location</h2>
      <p class="cp-para">{p.address}.</p>
      {p.geo && (
        <p style="margin-top:10px;">
          <a class="btn btn-secondary btn-sm" href={`https://www.google.com/maps/search/?api=1&query=${p.geo.lat},${p.geo.lng}`} target="_blank" rel="noopener">Open in Google Maps →</a>
          <a class="btn btn-secondary btn-sm" href={`/localities/${p.localitySlug}/`} style="margin-left:8px;">Property in {p.localityName} →</a>
        </p>
      )}
    </section>

    {siblings.length > 0 && (
      <section class="cp-sec" id="others">
        <h2>Other commercial projects we advise on</h2>
        <ul class="proj-grid">
          {siblings.map((o) => (
            <li>
              <a class="proj-card" href={commercialPath(o)}>
                {o.photos[0] ? <img src={o.photos[0]} alt={`${o.name}, ${o.localityName}`} loading="lazy" /> : <div class="ph" data-label="Photographs pending"></div>}
                <span class="proj-card-body">
                  <span class="proj-card-name">{o.name}</span>
                  <span class="proj-card-meta">{useSummary(o)} · {o.localityName}</span>
                  <span class="proj-card-meta muted">{o.floors} · {possessionLabel(o)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p style="margin-top:16px;"><a class="btn btn-secondary btn-sm" href={PROJECTS_INDEX}>See all {allProjects.length} projects →</a></p>
      </section>
    )}

    <section class="cp-sec cp-faq">
      <h2>Questions about {p.name}</h2>
      <dl class="faq-list">
        {c.faq.map((f) => <div class="faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>)}
      </dl>
    </section>

    <ProjectEnquiry subject={p.name} url={url} developer={p.developer} place={`${p.localityName}, Ahmedabad`} />
  </main>
</Base>

<style is:global>
  .cp .crumb { display: flex; align-items: center; gap: 8px; padding: 22px 0 6px; font-size: 13.5px; color: var(--text-muted); flex-wrap: wrap; }
  .cp .crumb .sep { color: var(--text-faint); }
  .cp .draft-banner { margin: 12px 0 0; padding: 10px 14px; border-radius: var(--r); background: #fff4d6; border: 1px solid #f0d48a; color: #6b4d00; font-size: 13.5px; font-weight: 600; }

  .cp .gallery { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 10px; height: 440px; border-radius: var(--r-xl); overflow: hidden; margin-top: 16px; }
  .cp .gallery .g0 { grid-row: 1 / 3; }
  .cp .gallery .cell { position: relative; cursor: pointer; overflow: hidden; }
  .cp .gallery .more { position: absolute; right: 12px; bottom: 12px; }

  .cp-head { margin-top: 28px; }
  .cp-head h1 { max-width: 18ch; margin-top: 10px; }
  .cp-facts { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--shadow-xs); overflow: hidden; }
  .cp-facts li { flex: 1 1 0; min-width: 150px; display: flex; flex-direction: column; gap: 3px; padding: 14px 18px; border-right: 1px solid var(--hairline); }
  .cp-facts li:last-child { border-right: 0; }
  .cp-facts span { font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; color: var(--text-muted); font-weight: 600; }
  .cp-facts b { font-size: 16px; color: var(--ink); font-weight: 650; }
  .cp-rate { margin-top: 14px; font-size: 17px; font-weight: 650; color: var(--navy); }

  /* Sticky in-page navigation — the same six anchors on every project. */
  .cp-nav { position: sticky; top: 0; z-index: 20; margin-top: 26px; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); }
  .cp-nav ul { list-style: none; margin: 0; padding: 0 6px; display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; }
  .cp-nav ul::-webkit-scrollbar { display: none; }
  .cp-nav a { display: block; padding: 13px 14px; font-size: 14.5px; font-weight: 600; color: var(--text-muted); white-space: nowrap; border-bottom: 2px solid transparent; transition: color var(--t) var(--ease), border-color var(--t) var(--ease); }
  .cp-nav a:hover { color: var(--ink); }
  .cp-nav a[aria-current] { color: var(--navy); border-bottom-color: var(--navy); }

  .cp-sec { margin-top: 52px; scroll-margin-top: 72px; }
  .cp h2 { font-size: clamp(22px, 2.4vw, 28px); margin-bottom: 12px; }
  .cp h3 { font-size: 16.5px; margin: 0 0 10px; }
  .cp-sub { color: var(--text-muted); margin: 0 0 16px; max-width: 74ch; line-height: 1.6; font-size: 14.5px; }
  .cp-para { max-width: 74ch; line-height: 1.7; margin-top: 12px; }
  .cp-note { font-size: 13px; color: var(--text-muted); margin-top: 10px; max-width: 74ch; line-height: 1.6; }
  .cp-rates { margin-top: 22px; }
  .cp-rates:first-of-type { margin-top: 0; }

  .cp .table-wrap { overflow-x: auto; }
  .cp .cmp-table { border-collapse: collapse; width: 100%; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); font-size: 14px; }
  .cp .cmp-table th, .cp .cmp-table td { text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .cp .cmp-table thead th { background: var(--surface-2); color: var(--text-muted); font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; white-space: nowrap; }
  .cp .cmp-table tbody th { font-weight: 700; color: var(--ink); white-space: nowrap; }
  .cp .cmp-table tbody tr:last-child th, .cp .cmp-table tbody tr:last-child td { border-bottom: 0; }

  .cp .facts-list { margin: 0; display: grid; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--shadow-xs); overflow: hidden; max-width: 820px; }
  .cp .facts-list > div { display: grid; grid-template-columns: 180px 1fr; gap: 12px; padding: 11px 16px; border-bottom: 1px solid var(--hairline); font-size: 14.5px; }
  .cp .facts-list > div:last-child { border-bottom: 0; }
  .cp .facts-list dt { color: var(--text-muted); font-weight: 600; }
  .cp .facts-list dd { margin: 0; color: var(--ink); font-weight: 500; word-break: break-word; }

  .cp .amen-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px 16px; max-width: 980px; }
  .cp .amen-list li { padding: 8px 12px; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r); font-size: 14px; }

  .cp .proj-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .cp .proj-card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-xs); transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease); }
  .cp .proj-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .cp .proj-card img, .cp .proj-card .ph { aspect-ratio: 16 / 10; width: 100%; object-fit: cover; object-position: center 30%; display: block; }
  .cp .proj-card-body { display: flex; flex-direction: column; gap: 3px; padding: 12px 14px 14px; }
  .cp .proj-card-name { font-weight: 700; color: var(--ink); font-size: 16px; }
  .cp .proj-card-meta { font-size: 13.5px; color: var(--text); }

  .cp-faq { max-width: 860px; }
  .cp .faq-list { margin: 0; }
  .cp .faq-item { padding: 16px 0; border-top: 1px solid var(--hairline); }
  .cp .faq-item dt { font-weight: 650; color: var(--ink); font-size: 16px; }
  .cp .faq-item dd { margin: 8px 0 0; color: var(--text); line-height: 1.6; }

  @media (max-width: 1000px) {
    .cp .proj-grid { grid-template-columns: repeat(2, 1fr); }
    .cp .amen-list { grid-template-columns: 1fr 1fr; }
    .cp .gallery { height: 340px; }
  }
  @media (max-width: 600px) {
    .cp .proj-grid, .cp .amen-list { grid-template-columns: 1fr; }
    .cp .facts-list > div { grid-template-columns: 1fr; gap: 2px; }
    .cp-facts li { flex-basis: 50%; border-bottom: 1px solid var(--hairline); }
  }
</style>

<script>
  // Highlight the section currently in view in the sticky nav.
  const nav = document.querySelector<HTMLElement>('.cp-nav');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links
      .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') || ''))
      .filter((el): el is HTMLElement => !!el);
    const mark = (id: string) => links.forEach((a) => a.toggleAttribute('aria-current', a.getAttribute('href') === `#${id}`));
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible) mark(visible.target.id);
      },
      { rootMargin: '-70px 0px -65% 0px', threshold: 0 },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
