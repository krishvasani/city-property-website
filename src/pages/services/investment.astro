---
import ServicePage from '../../components/ServicePage.astro';
---
<ServicePage
  serviceKey="investment"
  seoTitle="Real Estate Investment Advisory in Ahmedabad"
  seoDescription="City Property Services advises on real estate investment in Ahmedabad, including preleased assets and prelaunch projects, with careful guidance on income visibility and long term growth."
  eyebrow="Investment advisory"
  heading="Real Estate Investment Advisory"
  intro="Property can be a steady, sensible part of your portfolio when you pick the right asset. We help you invest in preleased properties and prelaunch opportunities chosen for income visibility and long term growth."
  lead={[
    "Some investors want predictable monthly income, while others are happy to wait for an asset to appreciate. We help you understand both paths and choose what fits your budget and your comfort with risk.",
    "A property that is already leased to a stable tenant tends to carry lower vacancy risk and clearer income visibility, which is why preleased assets appeal to many of our clients.",
  ]}
  helpItems={[
    "Preleased offices, showrooms and warehouses with a tenant in place",
    "Prelaunch opportunities at early stage pricing",
    "Commercial offices and retail showrooms for rental income",
    "Warehouse and industrial assets for portfolio balance",
    "Guidance on tenant profile, lease terms and rental stability",
    "Advice shaped around your budget and your comfort with risk",
  ]}
  idealFor={["First time investors", "Seasoned investors", "Rental income seekers", "Long term holders", "Business owners", "NRI investors"]}
  support={[
    { title: "Understand your goals", text: "We talk through your budget, your timeline and how much risk you are comfortable with." },
    { title: "Explain the options", text: "We compare preleased income assets with prelaunch growth plays in plain language." },
    { title: "Review the property and tenant", text: "For leased assets we look at the tenant profile, lease term and rental stability." },
    { title: "Weigh the numbers", text: "We help you read stable rental potential and long term appreciation potential, without overpromising." },
    { title: "Invest with clarity", text: "We support due diligence, documentation and a clean transaction." },
  ]}
  ctaLabel="Discuss Investment Options"
  formIntent="Investment"
  sizeHint="e.g. investment budget, or the rental income you want"
  relatedCategory="investment"
/>
