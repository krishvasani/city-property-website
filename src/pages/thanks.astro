---
import Base from '../layouts/Base.astro';
import { whatsappUrl } from '../lib/config';
const wa = whatsappUrl('Hi, I just sent an enquiry through your website.');
---
<Base title="Thank you" description="Your enquiry has been received.">
  <main class="wrap">
    <section class="thanks">
      <div class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 4 4 10-10"/></svg></div>
      <h1 class="h1">Thank you, we’ve got it.</h1>
      <p class="body-lg muted" style="max-width:48ch;margin:14px auto 0;">Your enquiry is in. One of our advisors will reach out shortly, usually the same day.</p>
      <div class="row" style="justify-content:center;gap:12px;margin-top:28px;">
        <a class="btn btn-primary" href="/buy">Browse more properties</a>
        <a class="btn btn-secondary" href={wa} target="_blank" rel="noopener">Message us on WhatsApp</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .thanks { text-align: center; padding: 120px 0 140px; }
  .check { width: 76px; height: 76px; border-radius: 999px; background: var(--good-tint); color: var(--good); display: grid; place-items: center; margin: 0 auto 24px; }
  .check svg { width: 34px; height: 34px; }
</style>
